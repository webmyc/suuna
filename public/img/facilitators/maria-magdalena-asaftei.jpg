      // Defer analytics until after page load
      window.addEventListener('load', async () => {
        try {
          // Only load analytics if the module exists
          if (typeof window !== 'undefined' && window.location.hostname !== 'localhost') {
            const { inject } = await import('@vercel/analytics');
            inject();
          }
        } catch (error) {
          // Silently fail analytics loading
          console.debug('Analytics not available:', error.message);
        }
      });
    </script> <!-- Deferred JavaScript Initialization --> <script>
      // Defer non-critical JavaScript initialization
      window.addEventListener('DOMContentLoaded', () => {
        const initNonCritical = () => {
          // Place non-critical initializers here
          // This runs during idle time or after 1 second timeout
        };
        
        if (window.requestIdleCallback) {
          requestIdleCallback(initNonCritical, { timeout: 1000 });
        } else {
          // Fallback for browsers without requestIdleCallback
          setTimeout(initNonCritical, 1000);
        }
      });
      
      // Audio toggle functionality for SUUNA page only
      window.addEventListener('DOMContentLoaded', () => {
        const audioToggle = document.getElementById('audioToggle');
        
        // Always hide audio toggle first, then show only on SUUNA page
        if (audioToggle) {
          audioToggle.style.display = 'none';
        }
        
        // Only show and initialize on SUUNA page
        if (window.location.pathname === '/suuna') {
          const audioIcon = document.getElementById('audioIcon');
          const audioText = document.getElementById('audioText');
          const backgroundAudio = document.getElementById('suunaBackgroundAudio');
          
          if (audioToggle && audioIcon && audioText && backgroundAudio) {
            audioToggle.style.display = 'flex';
            
            let isAudioMuted = false;
            
            // Muted icon SVG (speaker with X)
            const mutedIconSVG = `
              <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.824L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.824z" clip-rule="evenodd"/>
              <path d="M12.293 7.293a1 1 0 011.414 0L15 8.586l1.293-1.293a1 1 0 111.414 1.414L16.414 10l1.293 1.293a1 1 0 01-1.414 1.414L15 11.414l-1.293 1.293a1 1 0 01-1.414-1.414L13.586 10l-1.293-1.293a1 1 0 010-1.414z"/>
            `;
            
            // Unmuted icon SVG (speaker with sound waves)
            const unmutedIconSVG = `
              <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.824L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.824zM12 5.5a.5.5 0 00-.5.5v8a.5.5 0 001 0V6a.5.5 0 00-.5-.5z" clip-rule="evenodd"/>
              <path d="M14.5 6.5a.5.5 0 00-.5.5v6a.5.5 0 001 0V7a.5.5 0 00-.5-.5z"/>
              <path d="M16.5 4.5a.5.5 0 00-.5.5v10a.5.5 0 001 0V5a.5.5 0 00-.5-.5z"/>
            `;
            
            function updateAudioIcon() {
              if (isAudioMuted) {
                audioIcon.innerHTML = mutedIconSVG;
                audioText.textContent = 'Audio Off';
                audioToggle.setAttribute('aria-label', 'Unmute audio');
                audioToggle.setAttribute('title', 'Unmute audio');
              } else {
                audioIcon.innerHTML = unmutedIconSVG;
                audioText.textContent = 'Audio On';
                audioToggle.setAttribute('aria-label', 'Mute audio');
                audioToggle.setAttribute('title', 'Mute audio');
              }
            }
            
            audioToggle.addEventListener('click', () => {
              isAudioMuted = !isAudioMuted;
              
              if (isAudioMuted) {
                // Mute background audio
                backgroundAudio.pause();
              } else {
                // Unmute and resume background audio
                backgroundAudio.volume = 0.3;
                backgroundAudio.play().catch(console.warn);
              }
              
              updateAudioIcon();
            });
            
            // Initialize icon state
            updateAudioIcon();
          }
        }
      });
    </script> <!-- Enhanced global scrolling script for #book-call --> <script>
      // Enhanced global handler for #book-call scrolling
      function scrollToBookCall() {
        const element = document.getElementById('book-call');
        if (element) {
          // Immediate scroll without animation for better UX
          const rect = element.getBoundingClientRect();
          const offsetTop = window.pageYOffset + rect.top - 120; // 120px offset for header
          window.scrollTo({
            top: offsetTop,
            behavior: 'auto' // Immediate scroll
          });
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        // Handle direct URL navigation to #book-call
        if (window.location.hash === '#book-call') {
          // Immediate scroll on page load
          scrollToBookCall();
        }

        // Handle hash changes
        window.addEventListener('hashchange', function() {
          if (window.location.hash === '#book-call') {
            scrollToBookCall();
          }
        });

        // Handle anchor clicks globally
        document.addEventListener('click', function(e) {
          const target = e.target;
          if (target && target.closest) {
            const link = target.closest('a[href="#book-call"]');
            if (link) {
              e.preventDefault();
              scrollToBookCall();
              // Update URL without triggering scroll
              history.pushState(null, '', '#book-call');
            }
          }
        });
      });

      // Also handle window load event as backup
      window.addEventListener('load', function() {
        if (window.location.hash === '#book-call') {
          scrollToBookCall();
        }
      });
    </script> <!-- Theme persistence script --> <script>
      // Prevent layout shift by applying theme immediately
      (function() {
        const savedTheme = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark)
        
        if (isDark) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script> <!-- Performance optimization script --> <script>
      // Optimize loading performance
      (function() {
        // Preload critical resources on user interaction
        function preloadCriticalResources() {
          const criticalImages = [
            '/img/RESPIRA-LOGO.png'
          ];
          
          criticalImages.forEach(src => {
            const link = document.createElement('link');
            link.rel = 'preload';
            link.as = 'image';
            link.href = src;
            document.head.appendChild(link);
          });
        }

        // Preload on first user interaction
        ['mousedown', 'touchstart', 'keydown'].forEach(event => {
          document.addEventListener(event, preloadCriticalResources, { once: true });
        });

        // Optimize font loading
        if ('fonts' in document) {
          document.fonts.ready.then(() => {
            document.documentElement.classList.add('fonts-loaded');
          });
        }
      })();
    </script> <!-- Reveal Animation System --> <script>
      // Section reveal micro-motion with IntersectionObserver
      (function() {
        const root = document.documentElement;
        // Check for reduced motion preference
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.remove('motion-ready');
          return;
        }
        
        root.classList.add('motion-ready');
        
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, {
          rootMargin: '0px 0px -5% 0px',
          threshold: 0.1
        });
        
        // Observe all reveal elements
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
        
        // Fallback: ensure all sections are visible after 2 seconds
        setTimeout(() => {
          document.querySelectorAll('.reveal:not(.is-in)').forEach(el => {
            el.classList.add('is-in');
          });
        }, 2000);
      })();
    </script> <!-- Pine-cone Back to Top Button --> <script>
      // Pine-cone button functionality
      (function() {
        const btn = document.getElementById('toTop');
        const showAt = 320;
        
        if (!btn) return;
        
        // Show/hide based on scroll position
        addEventListener('scroll', () => {
          btn.hidden = (scrollY < showAt);
        }, { passive: true });
        
        // Smooth scroll to top on click
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script> </body> </html>