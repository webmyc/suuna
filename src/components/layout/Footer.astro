---
// Footer component
---

<footer class="border-t border-stone/30 dark:border-white/10 bg-bone dark:bg-[#0D1B22]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Newsletter Section -->
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-display font-semibold text-charcoal dark:text-bone mb-4">
        Stay Connected
      </h2>
      <p class="text-ash dark:text-[#B8C5D0] max-w-xl mx-auto mb-8">
        Subscribe to our community newsletter for the latest events, wisdom, and offerings
      </p>

      <!-- Substack embed -->
      <div class="max-w-md mx-auto">
        <iframe
          src="https://suuna.substack.com/embed"
          width="100%"
          height="320"
          style="border: 1px solid rgb(var(--color-border)); border-radius: 1rem; background: transparent;"
          frameborder="0"
          scrolling="no"
        ></iframe>
      </div>
    </div>

    <!-- Footer Links -->
    <div class="pt-12 border-t border-border">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="text-ash dark:text-[#B8C5D0] text-sm">
            © 2025 <span class="font-suuna text-sage dark:text-moss">SUUNA</span>. All rights reserved.
          </span>
        </div>

        <nav class="flex gap-8 text-sm">
          <a
            href="https://suuna.org"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ash dark:text-[#B8C5D0] hover:text-sage dark:hover:text-moss transition-colors"
          >
            About
          </a>
          <a
            href="https://lu.ma/suuna"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ash dark:text-[#B8C5D0] hover:text-sage dark:hover:text-moss transition-colors"
          >
            Events
          </a>
          <a
            href="https://suuna.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ash dark:text-[#B8C5D0] hover:text-sage dark:hover:text-moss transition-colors"
          >
            Blog
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>
