---
import { ThemeToggle } from '../ui/ThemeToggle';

// Get current path for active navigation
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-sage/10 shadow-lg shadow-sage/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-3xl font-suuna text-sage transition-all duration-300 group-hover:scale-105 group-hover:text-forest" style="font-family: 'Architype Bayer-type W90', sans-serif !important; text-shadow: 0 2px 10px rgba(74, 124, 89, 0.1);">
          SUUNA
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        <a
          href="/"
          class={`text-base font-medium transition-colors ${currentPath === '/' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Home
        </a>
        <a
          href="/manifesto"
          class={`text-base font-medium transition-colors ${currentPath === '/manifesto' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Manifesto
        </a>
        <a
          href="/facilitators"
          class={`text-base font-medium transition-colors ${currentPath.startsWith('/facilitators') || currentPath.startsWith('/guides') ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Guides
        </a>
        <a
          href="/events"
          class={`text-base font-medium transition-colors ${currentPath === '/events' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Events
        </a>
        <a
          href="/articles"
          class={`text-base font-medium transition-colors ${currentPath === '/articles' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Articles
        </a>
        <a
          href="/vault"
          class={`text-base font-medium transition-colors ${currentPath === '/vault' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Vault
        </a>
        <a
          href="/join"
          class={`px-6 py-2.5 bg-gradient-to-br from-sage to-forest text-white font-medium rounded-xl hover:shadow-md hover:shadow-sage/25 transition-all duration-300 hover:scale-105`}
        >
          Join
        </a>
      </nav>

      <!-- Right Side: Language + Theme -->
      <div class="hidden lg:flex items-center gap-4">
        <!-- Language Switcher -->
        <div class="flex items-center gap-3 text-sm bg-stone/30 rounded-xl px-3 py-1.5">
          <a href="?lang=ro" class="text-ash hover:text-sage transition-colors font-medium px-2 py-1 rounded-lg hover:bg-white/80">RO</a>
          <span class="text-stone/50">|</span>
          <a href="?lang=en" class="text-ash hover:text-sage transition-colors font-medium px-2 py-1 rounded-lg hover:bg-white/80">EN</a>
        </div>

        <!-- Theme Toggle -->
        <ThemeToggle client:load />
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 text-charcoal hover:text-sage transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-sage/10 bg-white/95 backdrop-blur-xl">
    <nav class="px-4 py-4 space-y-2">
      <a href="/" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Home</a>
      <a href="/manifesto" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Manifesto</a>
      <a href="/facilitators" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Guides</a>
      <a href="/events" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Events</a>
      <a href="/articles" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Articles</a>
      <a href="/vault" class="block py-2.5 text-base font-medium text-ash hover:text-sage hover:bg-stone/20 rounded-lg px-3 transition-all">Vault</a>
      <a href="/join" class="block py-3 text-base font-medium bg-gradient-to-br from-sage to-forest text-white rounded-xl text-center shadow-md hover:shadow-lg transition-all">Join</a>

      <div class="pt-4 mt-4 border-t border-sage/10 flex items-center justify-between">
        <div class="flex items-center gap-3 text-sm bg-stone/30 rounded-xl px-3 py-1.5">
          <a href="?lang=ro" class="text-ash hover:text-sage transition-colors px-2 py-1 rounded-lg hover:bg-white/80">RO</a>
          <span class="text-stone/50">|</span>
          <a href="?lang=en" class="text-ash hover:text-sage transition-colors px-2 py-1 rounded-lg hover:bg-white/80">EN</a>
        </div>
        <ThemeToggle client:load />
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

<style>
  header {
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
