---
import { ThemeToggle } from '../ui/ThemeToggle';

// Get current path for active navigation
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/98 backdrop-blur-xl border-b border-sage/15 shadow-xl shadow-sage/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-24 items-center justify-between">
      <!-- Logo - Bold and Present -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-4xl font-suuna text-sage transition-all duration-300 group-hover:scale-105 group-hover:text-forest" style="font-family: 'Architype Bayer-type W90', sans-serif !important; text-shadow: 0 2px 15px rgba(74, 124, 89, 0.15);">
          SUUNA
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-10">
        <a
          href="/"
          class={`text-base font-medium transition-colors ${currentPath === '/' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Home
        </a>
        <a
          href="/manifesto"
          class={`text-base font-medium transition-colors ${currentPath === '/manifesto' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Manifesto
        </a>
        <a
          href="/guides"
          class={`text-base font-medium transition-colors ${currentPath.startsWith('/guides') ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Guides
        </a>
        <a
          href="/events"
          class={`text-base font-medium transition-colors ${currentPath === '/events' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Events
        </a>
        <a
          href="/articles"
          class={`text-base font-medium transition-colors ${currentPath === '/articles' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Articles
        </a>
        <a
          href="/vault"
          class={`text-base font-medium transition-colors ${currentPath === '/vault' ? 'text-sage' : 'text-ash hover:text-charcoal'}`}
        >
          Vault
        </a>
        <a
          href="/join"
          class={`px-8 py-3 bg-gradient-to-br from-sage to-forest text-white font-semibold text-base rounded-[16px] hover:shadow-lg hover:shadow-sage/30 transition-all duration-300 hover:scale-105`}
        >
          Join
        </a>
      </nav>

      <!-- Right Side: Language + Theme -->
      <div class="hidden lg:flex items-center gap-5">
        <!-- Language Switcher - More Prominent -->
        <div class="flex items-center gap-3 text-base bg-stone/40 rounded-[14px] px-4 py-2">
          <a href="?lang=ro" class="text-ash hover:text-sage transition-colors font-semibold px-2.5 py-1 rounded-lg hover:bg-white/90">RO</a>
          <span class="text-stone/50">|</span>
          <a href="?lang=en" class="text-ash hover:text-sage transition-colors font-semibold px-2.5 py-1 rounded-lg hover:bg-white/90">EN</a>
        </div>

        <!-- Theme Toggle -->
        <ThemeToggle client:load />
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 text-charcoal hover:text-sage transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu - Updated -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-sage/15 bg-white/98 backdrop-blur-xl">
    <nav class="px-4 py-5 space-y-2">
      <a href="/" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Home</a>
      <a href="/manifesto" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Manifesto</a>
      <a href="/guides" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Guides</a>
      <a href="/events" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Events</a>
      <a href="/articles" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Articles</a>
      <a href="/vault" class="block py-3 text-base font-medium text-ash hover:text-sage hover:bg-stone/30 rounded-[12px] px-4 transition-all">Vault</a>
      <a href="/join" class="block py-4 text-base font-semibold bg-gradient-to-br from-sage to-forest text-white rounded-[16px] text-center shadow-lg hover:shadow-xl transition-all hover:scale-105">Join</a>

      <div class="pt-5 mt-4 border-t border-sage/15 flex items-center justify-between">
        <div class="flex items-center gap-3 text-base bg-stone/40 rounded-[14px] px-4 py-2">
          <a href="?lang=ro" class="text-ash hover:text-sage transition-colors font-semibold px-2.5 py-1 rounded-lg hover:bg-white/90">RO</a>
          <span class="text-stone/50">|</span>
          <a href="?lang=en" class="text-ash hover:text-sage transition-colors font-semibold px-2.5 py-1 rounded-lg hover:bg-white/90">EN</a>
        </div>
        <ThemeToggle client:load />
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

<style>
  header {
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
