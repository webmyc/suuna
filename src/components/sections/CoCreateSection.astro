---
// Co-create section component (pre-footer)
---

<section class="py-20 gradient-forest noise-overlay relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center">
      <div class="reveal">
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-suuna-text-light mb-8">
          Co-create with <span class="suuna-font text-suuna-accent" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span>
        </h2>
      </div>
      
      <div class="reveal-stagger max-w-4xl mx-auto space-y-6">
        <p class="text-xl text-suuna-text-light leading-relaxed">
          At <span class="suuna-font" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span>, we believe creators thrive when collaboration replaces competition. 
          We bring together teachers, healers, artists, and community builders under one 
          ecosystem where growth, technology, and wisdom co-evolve.
        </p>
        
        <p class="text-xl text-suuna-text-light leading-relaxed">
          By joining <span class="suuna-font" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span>, you contribute your essence to a field of collective intelligence — 
          where your work doesn't just grow, it resonates.
        </p>
      </div>
      
      <div class="reveal mt-12">
        <a 
          href="https://suuna.org"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg"
        >
          Visit <span class="suuna-font" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span>.org
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
        
        <p class="text-suuna-text-muted mt-4 text-sm">
          Stronger together. Built for partnership.
        </p>
      </div>
    </div>
  </div>
  
  <!-- Breathing circle animation -->
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 opacity-5">
    <div class="breathing-circle w-full h-full rounded-full border border-suuna-accent"></div>
  </div>
</section>
