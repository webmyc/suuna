---
// Hero Section - Per SUUNA Spec
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-bone via-stone to-bone">
  <!-- Optional: Subtle nature video background overlay -->
  <!-- <div class="absolute inset-0 opacity-10">
    <video autoplay loop muted playsinline class="w-full h-full object-cover">
      <source src="/videos/nature-background.mp4" type="video/mp4">
    </video>
  </div> -->

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-bone/50 to-bone"></div>

  <!-- Animated Background Elements -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-sage/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 4s;"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-terracotta/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 6s; animation-delay: 2s;"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center animate-fade-in">
    <h1 class="text-6xl md:text-7xl lg:text-8xl font-display font-bold text-forest-dark mb-6 leading-tight">
      <span class="font-suuna text-sage" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span>
    </h1>

    <p class="text-2xl md:text-3xl text-ash max-w-3xl mx-auto mb-16 font-display leading-relaxed">
      A Platform for Intentional Communities
    </p>

    <div class="flex flex-col sm:flex-row gap-6 justify-center">
      <a
        href="/join"
        class="inline-flex items-center justify-center gap-2 px-10 py-5 bg-sage text-white text-lg font-semibold rounded-full transition-all hover:bg-forest-dark hover:scale-105 shadow-lg"
      >
        Join the Community
      </a>
      <a
        href="/join#guides"
        class="inline-flex items-center justify-center gap-2 px-10 py-5 border-2 border-terracotta text-terracotta text-lg font-semibold rounded-full transition-all hover:bg-terracotta hover:text-white hover:scale-105"
      >
        Become a Guide
      </a>
    </div>
  </div>
</section>
