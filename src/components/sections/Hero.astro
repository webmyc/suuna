---
// Hero Section - Clean & Minimal
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-white">
  <!-- Subtle gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-sage/3 via-transparent to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
    <!-- SUUNA Wordmark -->
    <h1 class="mb-6">
      <span
        class="font-suuna text-sage text-7xl md:text-8xl inline-block"
        style="font-family: 'Architype Bayer-type W90', sans-serif !important; letter-spacing: 0.05em;"
      >
        SUUNA
      </span>
    </h1>

    <!-- Tagline -->
    <p class="text-lg md:text-xl text-charcoal/70 max-w-xl mx-auto mb-10">
      A platform for intentional communities
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
      <a
        href="/join"
        class="inline-flex items-center justify-center px-6 py-2.5 bg-sage text-white font-medium rounded-md transition-all hover:bg-forest-dark"
      >
        Join the Community
      </a>
      <a
        href="/manifesto"
        class="inline-flex items-center justify-center px-6 py-2.5 border border-charcoal/15 text-charcoal font-medium rounded-md transition-all hover:border-sage hover:text-sage"
      >
        Read Our Manifesto
      </a>
    </div>
  </div>
</section>
