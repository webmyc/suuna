---
// Hero Section - Bold, Warm, Intentional
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-b from-bone via-white to-sage/5">
  <!-- Large organic background shapes with real depth -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Main glow -->
    <div class="absolute -top-1/4 left-1/2 -translate-x-1/2 w-[1000px] h-[1000px] gradient-radial from-sage/30 via-sage/10 to-transparent rounded-full blur-[100px] animate-breathe-slow"></div>

    <!-- Floating organic shapes -->
    <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-gradient-to-br from-terracotta/20 via-honey/15 to-transparent rounded-full blur-3xl animate-float-slow"></div>
    <div class="absolute bottom-20 left-1/4 w-[350px] h-[350px] bg-gradient-to-br from-moss/25 via-sage/15 to-transparent rounded-full blur-3xl animate-float-slower"></div>
    <div class="absolute top-1/2 right-1/3 w-[300px] h-[300px] bg-gradient-to-br from-honey/20 to-transparent rounded-full blur-2xl animate-float"></div>
  </div>

  <!-- Content with generous spacing -->
  <div class="relative z-10 mx-auto max-w-6xl px-6 sm:px-8 lg:px-12 text-center py-20">
    <!-- SUUNA Wordmark - Bold and Confident -->
    <div class="mb-12">
      <h1 class="inline-block animate-breathe-slow">
        <span
          class="block font-suuna text-sage text-[120px] sm:text-[160px] lg:text-[200px] leading-none tracking-wide"
          style="font-family: 'Architype Bayer-type W90', sans-serif !important;
                 text-shadow: 0 4px 40px rgba(74, 124, 89, 0.3),
                             0 2px 20px rgba(74, 124, 89, 0.2);"
        >
          SUUNA
        </span>
      </h1>
    </div>

    <!-- Tagline with breathing space -->
    <p class="text-2xl md:text-3xl text-ash max-w-3xl mx-auto mb-16 leading-relaxed font-light">
      A home for <span class="text-sage font-medium">intentional communities</span>
    </p>

    <!-- CTAs with real presence -->
    <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-20">
      <a
        href="/join"
        class="group relative inline-flex items-center justify-center px-12 py-5 bg-gradient-to-br from-sage via-forest to-sage text-white text-lg font-semibold rounded-[20px] shadow-2xl shadow-sage/40 hover:shadow-sage/50 transition-all duration-500 hover:scale-105 hover:-translate-y-1 overflow-hidden"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <span class="relative z-10">Join the Community</span>
      </a>
      <a
        href="/manifesto"
        class="group inline-flex items-center justify-center px-12 py-5 bg-white/90 backdrop-blur-md border-3 border-sage/30 text-charcoal text-lg font-semibold rounded-[20px] shadow-xl hover:shadow-2xl hover:bg-white hover:border-sage/50 transition-all duration-500 hover:scale-105 hover:-translate-y-1"
      >
        <span class="relative z-10">Read Our Manifesto</span>
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="animate-bounce-slow">
      <svg class="w-8 h-8 mx-auto text-sage/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  @keyframes float-slow {
    0%, 100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    33% {
      transform: translate(30px, -30px) scale(1.1) rotate(5deg);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9) rotate(-5deg);
    }
  }

  @keyframes float-slower {
    0%, 100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate(-40px, -20px) scale(1.05) rotate(-3deg);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(20px, -20px) scale(1.1);
    }
  }

  @keyframes breathe-slow {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }

  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-float-slow {
    animation: float-slow 20s ease-in-out infinite;
  }

  .animate-float-slower {
    animation: float-slower 25s ease-in-out infinite;
  }

  .animate-float {
    animation: float 15s ease-in-out infinite;
  }

  .animate-breathe-slow {
    animation: breathe-slow 8s ease-in-out infinite;
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }
</style>
