---
import { fetchSubstackFeed } from '../../utils/substack';

export interface Props {
  url: string;
  authorName: string;
  sectionTitle: string;
}

const { url, authorName, sectionTitle } = Astro.props;

// Fetch individual Substack feed
let feed;
try {
  feed = await fetchSubstackFeed(url, authorName);
} catch (error) {
  console.error(`Error fetching Substack feed for ${authorName}:`, error);
  // Fallback to empty feed if RSS fails
  feed = {
    title: authorName,
    description: `Latest posts from ${authorName}`,
    url,
    posts: []
  };
}
---

<section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-serif font-bold text-suuna-text-light mb-4">
        {sectionTitle}
      </h2>
      <p class="text-lg text-suuna-text-muted max-w-2xl mx-auto">
        Discover wisdom and insights from {authorName}
      </p>
    </div>

    <div class="reveal-stagger">
      <!-- Articles Grid Layout (1 large + 5 small) -->
      {feed.posts.length > 0 && (
        <div class="articles-grid-container mb-8">
          <!-- Column 1: Single Featured Article -->
          <div class="column-1">
            {feed.posts[0] && (
              <article class="group reveal">
                <!-- Article Image -->
                {feed.posts[0].image ? (
                  <a 
                    href={feed.posts[0].link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block aspect-[16/9] overflow-hidden mb-6 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                  >
                    <img 
                      src={feed.posts[0].image} 
                      alt={feed.posts[0].title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      width="600"
                      height="337"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div class="aspect-[16/9] mb-6 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                    <div class="text-center p-8">
                      <div class="w-16 h-16 mx-auto mb-4 bg-suuna-accent rounded-full flex items-center justify-center">
                        <svg class="w-8 h-8 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                      </div>
                      <p class="text-suuna-accent font-medium text-sm">Article Preview</p>
                    </div>
                  </div>
                )}
                
                <!-- Article Content -->
                <div class="space-y-4">
                  <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                    <span>{feed.posts[0].author}</span>
                    <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                    <span>5 min</span>
                  </div>
                  
                  <h3 class="text-2xl font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                    <a 
                      href={feed.posts[0].link} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="hover:text-suuna-accent transition-colors duration-300"
                    >
                      {feed.posts[0].title}
                    </a>
                  </h3>
                  
                  <p class="text-suuna-text-muted leading-relaxed text-base">
                    {feed.posts[0].description.substring(0, 150)}...
                  </p>
                </div>
              </article>
            )}
          </div>

          <!-- Column 2: Two Articles -->
          <div class="column-2">
            {feed.posts.slice(1, 3).map((post, index) => (
              <article class="group reveal">
                <!-- Article Image -->
                {post.image ? (
                  <a 
                    href={post.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                  >
                    <img 
                      src={post.image} 
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      width="400"
                      height="225"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div class="aspect-[16/9] mb-4 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                    <div class="text-center p-4">
                      <div class="w-12 h-12 mx-auto mb-2 bg-suuna-accent rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                      </div>
                      <p class="text-suuna-accent font-medium text-xs">Article</p>
                    </div>
                  </div>
                )}
                
                <!-- Article Content -->
                <div class="space-y-3">
                  <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                    <span>{post.author}</span>
                    <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                    <span>5 min</span>
                  </div>
                  
                  <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                    <a 
                      href={post.link} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="hover:text-suuna-accent transition-colors duration-300"
                    >
                      {post.title}
                    </a>
                  </h3>
                  
                  <p class="text-suuna-text-muted leading-relaxed text-sm">
                    {post.description.substring(0, 120)}...
                  </p>
                </div>
              </article>
            ))}
          </div>

          <!-- Column 3: Two Articles -->
          <div class="column-3">
            {feed.posts.slice(3, 5).map((post, index) => (
              <article class="group reveal">
                <!-- Article Image -->
                {post.image ? (
                  <a 
                    href={post.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                  >
                    <img 
                      src={post.image} 
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      width="400"
                      height="225"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div class="aspect-[16/9] mb-4 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                    <div class="text-center p-4">
                      <div class="w-12 h-12 mx-auto mb-2 bg-suuna-accent rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                      </div>
                      <p class="text-suuna-accent font-medium text-xs">Article</p>
                    </div>
                  </div>
                )}
                
                <!-- Article Content -->
                <div class="space-y-3">
                  <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                    <span>{post.author}</span>
                    <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                    <span>5 min</span>
                  </div>
                  
                  <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                    <a 
                      href={post.link} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="hover:text-suuna-accent transition-colors duration-300"
                    >
                      {post.title}
                    </a>
                  </h3>
                  
                  <p class="text-suuna-text-muted leading-relaxed text-sm">
                    {post.description.substring(0, 120)}...
                  </p>
                </div>
              </article>
            ))}
          </div>
          
          <!-- Additional Articles Row (1 article) -->
          {feed.posts[5] && (
            <div class="col-span-full mt-16">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <article class="group reveal">
                  <!-- Article Image -->
                  <a 
                    href={feed.posts[5].link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                  >
                    {feed.posts[5].image ? (
                      <img 
                        src={feed.posts[5].image} 
                        alt={feed.posts[5].title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        width="400"
                        height="225"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-suuna-forest/50 flex items-center justify-center">
                        <div class="text-center p-8">
                          <div class="w-16 h-16 mx-auto mb-4 bg-suuna-accent rounded-full flex items-center justify-center">
                            <svg class="w-8 h-8 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                            </svg>
                          </div>
                          <p class="text-suuna-accent font-medium text-sm">Article Preview</p>
                        </div>
                      </div>
                    )}
                  </a>
                  
                  <!-- Article Content -->
                  <div class="space-y-3">
                    <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                      <span>{feed.posts[5].author}</span>
                      <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                      <span>5 min</span>
                    </div>
                    
                    <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                      <a 
                        href={feed.posts[5].link} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="hover:text-suuna-accent transition-colors duration-300"
                      >
                        {feed.posts[5].title}
                      </a>
                    </h3>
                    
                    <p class="text-suuna-text-muted leading-relaxed text-sm">
                      {feed.posts[5].description.substring(0, 120)}...
                    </p>
                  </div>
                </article>
              </div>
            </div>
          )}
        </div>
      )}

      <!-- Subscribe Form -->
      <div class="text-center">
        <div class="glass rounded-lg p-6 max-w-md mx-auto">
          <h4 class="text-lg font-serif font-semibold text-suuna-text-light mb-4">
            Stay connected with {authorName}
          </h4>
          <iframe 
            src={`${feed.url}/embed`}
            width="100%" 
            height="200" 
            frameborder="0"
            class="rounded-lg"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .articles-grid-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    align-items: start;
  }

  .column-1 {
    display: flex;
    flex-direction: column;
  }

  .column-2 {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .column-3 {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .articles-grid-container {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    
    .column-1 {
      grid-column: span 2;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 768px) {
    .articles-grid-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .column-1 {
      grid-column: span 1;
      margin-bottom: 0;
    }
    
    .column-2,
    .column-3 {
      gap: 1.5rem;
    }
  }
</style>
