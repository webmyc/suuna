---
import { fetchAllSubstackFeeds } from '../../utils/substack';

// Fetch all Substack articles
let allArticles: Array<{
  title: string;
  link: string;
  published: string;
  summary?: string;
  author: string;
  readTime?: string;
  image?: string;
  featured?: boolean;
}> = [];

try {
  const substackFeeds = await fetchAllSubstackFeeds();
  
  // Flatten all articles from all feeds
  allArticles = substackFeeds.flatMap(feed => 
    feed.posts.map(post => ({
      title: post.title,
      link: post.link,
      published: post.pubDate,
      summary: post.description,
      author: post.author,
      readTime: '5 min', // Default read time
      image: post.image,
      featured: false
    }))
  );
  
  // Sort by publication date (newest first)
  allArticles.sort((a, b) => new Date(b.published).getTime() - new Date(a.published).getTime());
  
  // Set the first article as featured
  if (allArticles.length > 0) {
    allArticles[0].featured = true;
  }
  
} catch (error) {
  console.error('Error fetching Substack articles:', error);
  allArticles = [];
}

// Limit to 8 articles max
const displayArticles = allArticles.slice(0, 8);

// Organize articles into layout: 1 + 2 + 2 + 3 equal columns
const column1Article = displayArticles[0];
const column2Articles = displayArticles.slice(1, 3);
const column3Articles = displayArticles.slice(3, 5);
const additionalArticles = displayArticles.slice(5, 8);

// Helper function to format date
function formatDate(dateString: string): string {
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    });
  } catch {
    return dateString;
  }
}

// Helper function to truncate text
function truncateText(text: string, maxLength: number = 200): string {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength).trim() + '...';
}

// Helper function to clean HTML entities
function cleanHtmlEntities(text: string): string {
  return text
    .replace(/&#8220;/g, '"')
    .replace(/&#8221;/g, '"')
    .replace(/&#8216;/g, "'")
    .replace(/&#8217;/g, "'")
    .replace(/&#8212;/g, '—')
    .replace(/&#8211;/g, '–')
    .replace(/&#8230;/g, '…')
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
}
---

<section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-suuna-accent/20 border border-suuna-accent/30 shadow-sm mb-6">
        <svg class="w-5 h-5 text-suuna-accent" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
        </svg>
        <h2 class="text-sm uppercase tracking-[0.3em] text-suuna-accent font-semibold">Community Voices</h2>
      </div>
      
      <h2 class="text-4xl font-serif font-bold text-suuna-text-light mb-6">
        Recent Articles
      </h2>
      
      <p class="text-lg text-suuna-text-muted max-w-3xl mx-auto leading-relaxed">
        Discover wisdom and insights from our community of facilitators and creators
      </p>
    </div>

    <!-- Articles Grid -->
    {displayArticles.length > 0 && (
      <div class="articles-grid-container">
        <!-- Column 1: Single Featured Article -->
        <div class="column-1">
          {column1Article && (
            <article class="group reveal">
              <!-- Article Image -->
              {column1Article.image ? (
                <a 
                  href={column1Article.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="block aspect-[16/9] overflow-hidden mb-6 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                >
                  <img 
                    src={column1Article.image} 
                    alt={column1Article.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width="600"
                    height="337"
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="aspect-[16/9] mb-6 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                  <div class="text-center p-8">
                    <div class="w-16 h-16 mx-auto mb-4 bg-suuna-accent rounded-full flex items-center justify-center">
                      <svg class="w-8 h-8 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                      </svg>
                    </div>
                    <p class="text-suuna-accent font-medium text-sm">Article Preview</p>
                  </div>
                </div>
              )}
              
              <!-- Article Content -->
              <div class="space-y-4">
                <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                  <span>{column1Article.author}</span>
                  <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                  <span>{column1Article.readTime}</span>
                </div>
                
                <h3 class="text-2xl font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                  <a 
                    href={column1Article.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="hover:text-suuna-accent transition-colors duration-300"
                  >
                    {cleanHtmlEntities(column1Article.title)}
                  </a>
                </h3>
                
                {column1Article.summary && (
                  <p class="text-suuna-text-muted leading-relaxed text-base">
                    {cleanHtmlEntities(truncateText(column1Article.summary, 150))}
                  </p>
                )}
              </div>
            </article>
          )}
        </div>

        <!-- Column 2: Two Articles -->
        <div class="column-2">
          {column2Articles.map((article, index) => (
            <article class="group reveal">
              <!-- Article Image -->
              {article.image ? (
                <a 
                  href={article.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                >
                  <img 
                    src={article.image} 
                    alt={article.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width="400"
                    height="225"
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="aspect-[16/9] mb-4 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                  <div class="text-center p-4">
                    <div class="w-12 h-12 mx-auto mb-2 bg-suuna-accent rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                      </svg>
                    </div>
                    <p class="text-suuna-accent font-medium text-xs">Article</p>
                  </div>
                </div>
              )}
              
              <!-- Article Content -->
              <div class="space-y-3">
                <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                  <span>{article.author}</span>
                  <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                  <span>{article.readTime}</span>
                </div>
                
                <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                  <a 
                    href={article.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="hover:text-suuna-accent transition-colors duration-300"
                  >
                    {cleanHtmlEntities(article.title)}
                  </a>
                </h3>
                
                {article.summary && (
                  <p class="text-suuna-text-muted leading-relaxed text-sm">
                    {cleanHtmlEntities(truncateText(article.summary, 120))}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>

        <!-- Column 3: Two Articles -->
        <div class="column-3">
          {column3Articles.map((article, index) => (
            <article class="group reveal">
              <!-- Article Image -->
              {article.image ? (
                <a 
                  href={article.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                >
                  <img 
                    src={article.image} 
                    alt={article.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width="400"
                    height="225"
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="aspect-[16/9] mb-4 rounded-2xl bg-suuna-forest/50 flex items-center justify-center">
                  <div class="text-center p-4">
                    <div class="w-12 h-12 mx-auto mb-2 bg-suuna-accent rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                      </svg>
                    </div>
                    <p class="text-suuna-accent font-medium text-xs">Article</p>
                  </div>
                </div>
              )}
              
              <!-- Article Content -->
              <div class="space-y-3">
                <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                  <span>{article.author}</span>
                  <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                  <span>{article.readTime}</span>
                </div>
                
                <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                  <a 
                    href={article.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="hover:text-suuna-accent transition-colors duration-300"
                  >
                    {cleanHtmlEntities(article.title)}
                  </a>
                </h3>
                
                {article.summary && (
                  <p class="text-suuna-text-muted leading-relaxed text-sm">
                    {cleanHtmlEntities(truncateText(article.summary, 120))}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
        
        <!-- Additional Articles Row (3 equal columns) -->
        {additionalArticles.length > 0 && (
          <div class="col-span-full mt-16">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {additionalArticles.map((article, index) => (
                <article class="group reveal">
                  <!-- Article Image -->
                  <a 
                    href={article.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block aspect-[16/9] overflow-hidden mb-4 rounded-2xl hover:opacity-90 transition-opacity duration-300"
                  >
                    {article.image ? (
                      <img 
                        src={article.image} 
                        alt={article.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        width="400"
                        height="225"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-suuna-forest/50 flex items-center justify-center">
                        <div class="text-center p-8">
                          <div class="w-16 h-16 mx-auto mb-4 bg-suuna-accent rounded-full flex items-center justify-center">
                            <svg class="w-8 h-8 text-suuna-bg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                            </svg>
                          </div>
                          <p class="text-suuna-accent font-medium text-sm">Article Preview</p>
                        </div>
                      </div>
                    )}
                  </a>
                  
                  <!-- Article Content -->
                  <div class="space-y-3">
                    <div class="flex items-center space-x-3 text-sm text-suuna-text-muted font-medium">
                      <span>{article.author}</span>
                      <span class="w-1 h-1 rounded-full bg-suuna-text-muted"></span>
                      <span>{article.readTime}</span>
                    </div>
                    
                    <h3 class="text-lg font-serif font-bold text-suuna-text-light leading-tight tracking-tight">
                      <a 
                        href={article.link} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="hover:text-suuna-accent transition-colors duration-300"
                      >
                        {cleanHtmlEntities(article.title)}
                      </a>
                    </h3>
                    
                    {article.summary && (
                      <p class="text-suuna-text-muted leading-relaxed text-sm">
                        {cleanHtmlEntities(truncateText(article.summary, 120))}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
    
    {displayArticles.length === 0 && (
      <div class="text-center py-16">
        <p class="text-suuna-text-muted text-xl">No articles available at the moment.</p>
      </div>
    )}
  </div>
</section>

<style>
  .articles-grid-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    align-items: start;
  }

  .column-1 {
    display: flex;
    flex-direction: column;
  }

  .column-2 {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .column-3 {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .articles-grid-container {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    
    .column-1 {
      grid-column: span 2;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 768px) {
    .articles-grid-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .column-1 {
      grid-column: span 1;
      margin-bottom: 0;
    }
    
    .column-2,
    .column-3 {
      gap: 1.5rem;
    }
  }
</style>
