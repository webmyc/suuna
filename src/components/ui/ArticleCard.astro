---
import type { Article } from '../../types'
import { formatDate } from '../../utils/helpers'

interface Props {
  article: Article
}

const { article } = Astro.props
const formattedDate = article.publishedAt ? formatDate(article.publishedAt) : null
---

<article class="glass rounded-3xl overflow-hidden hover-lift group h-full flex flex-col">
  {article.image && (
    <div class="relative aspect-[16/9] overflow-hidden">
      <img
        src={article.image}
        alt={article.title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6 flex-1 flex flex-col">
    {article.author && (
      <div class="flex items-center gap-2 text-sm text-accent mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>{article.author}</span>
        {formattedDate && (
          <>
            <span class="text-secondary">•</span>
            <span class="text-secondary">{formattedDate}</span>
          </>
        )}
      </div>
    )}

    <h3 class="text-xl font-semibold text-primary mb-3 line-clamp-2 group-hover:text-accent transition-colors">
      {article.title}
    </h3>

    {article.excerpt && (
      <p class="text-sm text-secondary mb-4 line-clamp-3 flex-1">
        {article.excerpt}
      </p>
    )}

    {article.tags && article.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {article.tags.slice(0, 3).map((tag) => (
          <span class="px-2 py-1 rounded-full bg-secondary text-primary text-xs font-medium">
            {tag}
          </span>
        ))}
      </div>
    )}

    <a
      href={article.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-accent font-medium hover:underline mt-auto"
    >
      Read Article
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>
</article>
