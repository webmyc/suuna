---
import Base from '../components/layout/Base.astro';

const title = 'Page Not Found - SUUNA';
const description = 'The page you are looking for could not be found.';
---

<Base title={title} description={description}>
  <div class="min-h-screen bg-bone dark:bg-[#0D1B22] flex items-center justify-center px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-6xl sm:text-8xl font-display font-bold text-charcoal dark:text-bone mb-6">
        404
      </h1>
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-charcoal dark:text-bone mb-4">
        Page Not Found
      </h2>
      <p class="text-lg text-ash dark:text-[#B8C5D0] mb-8 max-w-xl mx-auto">
        The page you are looking for could not be found. It may have been moved or deleted.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-3 bg-sage dark:bg-moss text-white font-semibold rounded-xl hover:bg-forest-dark dark:hover:bg-sage transition-all focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2"
        >
          Go Home
        </a>
        <a
          href="/guides"
          class="inline-flex items-center justify-center px-8 py-3 bg-white dark:bg-[#1E2B38] border-2 border-stone/30 dark:border-white/10 text-charcoal dark:text-bone font-semibold rounded-xl hover:bg-stone/50 dark:hover:bg-white/10 transition-all focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2"
        >
          Browse Guides
        </a>
      </div>
    </div>
  </div>
</Base>

