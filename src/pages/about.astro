---
import Base from '../components/layout/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'About - SUUNA';
const description = 'Learn about SUUNA\'s mission to support wisdom creators and build intentional communities through partnership and collaboration.';
---

<Base 
  title={title}
  description={description}
  canonical="https://suuna.ro/about"
>
  <Header />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-suuna-text-light mb-6">
            About <span class="suuna-font text-suuna-accent">SUUNA</span>
          </h1>
          <p class="text-xl text-suuna-text-muted max-w-3xl mx-auto">
            We believe creators thrive when collaboration replaces competition. 
            Built for partnership, designed for growth.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-forest to-suuna-bg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal">
            <h2 class="text-3xl font-serif font-bold text-suuna-text-light mb-6">
              Our Mission
            </h2>
            <p class="text-lg text-suuna-text-light leading-relaxed mb-6">
              At SUUNA, we help creators amplify their message and grow their communities — 
              without the technical or marketing headaches. Whether you're launching workshops, 
              courses, or exclusive content, we provide everything you need to reach your audience and beyond.
            </p>
            <p class="text-xl text-suuna-accent font-semibold">
              You teach. We amplify.
            </p>
          </div>
          
          <div class="reveal-right">
            <div class="glass rounded-2xl p-8">
              <h3 class="text-2xl font-serif font-semibold text-suuna-text-light mb-4">
                Stronger together
              </h3>
              <p class="text-suuna-text-muted mb-6">
                Built for partnership. When you win, we win.
              </p>
              <a 
                href="https://suuna.org"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex items-center px-6 py-3 rounded-lg font-medium transition-all duration-300 hover:scale-105"
              >
                Join SUUNA
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-serif font-bold text-suuna-text-light mb-4">
            Our Values
          </h2>
          <p class="text-lg text-suuna-text-muted max-w-2xl mx-auto">
            Four pillars that guide everything we do
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="reveal-stagger">
            <div class="card p-8 h-full">
              <h3 class="text-xl font-serif font-semibold text-suuna-text-light mb-4">
                Community Discoverability
              </h3>
              <p class="text-suuna-text-muted mb-4">
                Your community meets other communities. By bringing together creators on one platform, 
                SUUNA helps you get discovered beyond your existing audience.
              </p>
              <p class="text-sm text-suuna-accent">
                SUUNA is the festival grounds. You bring the teaching.
              </p>
            </div>
          </div>

          <div class="reveal-stagger">
            <div class="card p-8 h-full">
              <h3 class="text-xl font-serif font-semibold text-suuna-text-light mb-4">
                Calm Driven Revenue Share
              </h3>
              <p class="text-suuna-text-muted mb-4">
                We grow when you grow. No upfront costs. No platform fees until you make money. 
                We built SUUNA with transparent, automated profit sharing.
              </p>
              <p class="text-sm text-suuna-accent">
                When you thrive, we thrive. That's the partnership.
              </p>
            </div>
          </div>

          <div class="reveal-stagger">
            <div class="card p-8 h-full">
              <h3 class="text-xl font-serif font-semibold text-suuna-text-light mb-4">
                Technology is Your Ally
              </h3>
              <p class="text-suuna-text-muted mb-4">
                Stop paying for five platforms. Use one. SUUNA brings it all together—courses, 
                community, content hosting, and a strong tech stack.
              </p>
              <p class="text-sm text-suuna-accent">
                You focus on teaching. We handle the infrastructure.
              </p>
            </div>
          </div>

          <div class="reveal-stagger">
            <div class="card p-8 h-full">
              <h3 class="text-xl font-serif font-semibold text-suuna-text-light mb-4">
                We Both Focus on What We Love
              </h3>
              <p class="text-suuna-text-muted mb-4">
                You shouldn't need an MBA in Instagram marketing to share your work with the world. 
                Content strategy, discovery, audience growth—we've got you covered.
              </p>
              <p class="text-sm text-suuna-accent">
                We call it Human as a Service (HaaS). Everyone wins.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-forest to-suuna-bg">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <h2 class="text-3xl font-serif font-bold text-suuna-text-light mb-6">
            Feel you belong?
          </h2>
          <p class="text-xl text-suuna-text-muted mb-8">
            Let's chat about it.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="https://suuna.org"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-300 hover:scale-105"
            >
              Visit SUUNA.org
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            
            <a 
              href="/facilitators"
              class="btn-secondary inline-flex items-center px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-300 hover:scale-105"
            >
              Meet Our Facilitators
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<style>
  @import '../styles/fonts.css';
  @import '../styles/theme.css';
  @import '../styles/reveal.css';
</style>
