---
import Base from '../components/layout/Base.astro';
import { fetchAllSubstackFeeds } from '../utils/substack';

// Page metadata
const title = 'Insights & Reflections - SUUNA';
const description = 'Wisdom from our community of guides. Articles, essays, and reflections on transformation, relationships, and intentional living.';

// Fetch all Substack articles
const feeds = await fetchAllSubstackFeeds();

// Get author filter from URL params
const url = new URL(Astro.request.url);
const authorFilter = url.searchParams.get('author');

// Get unique authors from feeds
const authors = [...new Set(feeds.map(feed => feed.title))].sort();

// Combine all posts and sort by date
const allPosts = feeds
  .flatMap(feed => feed.posts)
  .filter(post => !authorFilter || post.author === authorFilter)
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

// Get featured article (most recent with image)
const featuredArticle = allPosts.find(post => post.image) || allPosts[0];

// Get latest articles (excluding featured)
const latestArticles = allPosts.filter(post => post !== featuredArticle).slice(0, 12);

// Helper function to format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    month: 'long', 
    day: 'numeric', 
    year: 'numeric' 
  });
}

function formatShortDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    month: 'short', 
    day: 'numeric' 
  });
}
---

<Base title={title} description={description} canonical="https://suuna.ro/articles">
  <div class="min-h-screen bg-bone dark:bg-[#0D1B22]">
    <!-- Hero Section - Editorial Style -->
    <section class="relative pt-24 sm:pt-32 pb-12 sm:pb-16 px-4 border-b border-stone/30 dark:border-white/10">
      <div class="max-w-6xl mx-auto">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-display font-bold text-charcoal dark:text-bone mb-4 sm:mb-6 tracking-tight leading-[1.1]">
          Insights &<br class="hidden sm:block"/>Reflections
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl text-ash dark:text-[#B8C5D0] max-w-3xl leading-relaxed">
          Wisdom from our community of guides.
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-honey to-terracotta mx-auto rounded-full mt-8"></div>
      </div>
    </section>

    <!-- Filter Section -->
    <section class="py-10 px-4">
      <div class="max-w-7xl mx-auto flex justify-center">
        <div class="inline-flex items-center gap-4 bg-white/90 backdrop-blur-sm rounded-[8px] px-8 py-4 shadow-lg shadow-honey/10 border border-honey/10">
          <label for="author-filter" class="text-base font-medium text-ash">Filter by author:</label>
          <select
            id="author-filter"
            class="bg-stone/20 border-none text-charcoal font-medium focus:outline-none focus:ring-2 focus:ring-honey rounded-[8px] px-4 py-2 transition-all cursor-pointer hover:bg-stone/30"
            onchange="window.location.href = this.value === 'all' ? '/articles' : `/articles?author=${encodeURIComponent(this.value)}`"
          >
            <option value="all" selected={!authorFilter}>All Authors</option>
            {authors.map(author => (
              <option value={author} selected={authorFilter === author}>
                {author}
              </option>
            ))}
          </select>
        </div>
      </div>
    </section>

    <!-- Featured Article - Large Hero -->
    {featuredArticle && (
      <article class="relative border-b border-stone/30 dark:border-white/10">
        <a href={featuredArticle.link} target="_blank" rel="noopener noreferrer" class="block group focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2 rounded-xl">
          <div class="max-w-6xl mx-auto px-4 py-12 sm:py-16 md:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center">
              {featuredArticle.image && (
                <div class="relative aspect-[4/3] overflow-hidden rounded-xl">
                  <img 
                    src={featuredArticle.image} 
                    alt={featuredArticle.title || 'Featured article image'}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                    loading="eager"
                    width="800"
                    height="600"
                  />
                </div>
              )}
              <div class={featuredArticle.image ? '' : 'lg:col-span-2'}>
                <div class="text-xs font-semibold text-sage dark:text-moss mb-3 sm:mb-4 uppercase tracking-[0.15em]">
                  Featured
                </div>
                <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold text-charcoal dark:text-bone mb-4 sm:mb-6 leading-tight tracking-tight group-hover:text-sage dark:group-hover:text-moss transition-colors duration-300">
                  {featuredArticle.title}
                </h2>
                <div class="flex items-center gap-4 text-sm text-ash dark:text-[#B8C5D0] mb-6 font-medium">
                  <span>{featuredArticle.author}</span>
                  <span class="text-stone/40 dark:text-white/20">·</span>
                  <time datetime={featuredArticle.pubDate}>
                    {formatDate(featuredArticle.pubDate)}
                  </time>
                </div>
                {featuredArticle.excerpt && (
                  <p class="text-lg md:text-xl text-ash dark:text-[#B8C5D0] leading-relaxed line-clamp-4">
                    {featuredArticle.excerpt}
                  </p>
                )}
              </div>
            </div>
          </div>
        </a>
      </article>
    )}

    <!-- Latest Articles - Editorial 2-Column Layout -->
    <section class="py-12 sm:py-16 md:py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-charcoal dark:text-bone mb-8 sm:mb-12 pb-4 sm:pb-6 border-b border-stone/30 dark:border-white/10">
          Latest
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 md:gap-x-12 lg:gap-x-16 gap-y-12 sm:gap-y-16 md:gap-y-20">
          {latestArticles.map((post) => (
            <article class="group">
              <a href={post.link} target="_blank" rel="noopener noreferrer" class="block focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2 rounded-lg">
                {post.image && (
                  <div class="relative aspect-[16/10] overflow-hidden rounded-lg mb-4 sm:mb-6">
                    <img 
                      src={post.image} 
                      alt={post.title || 'Article image'}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                      loading="lazy"
                      width="600"
                      height="375"
                    />
                  </div>
                )}
                <h3 class="text-xl sm:text-2xl md:text-3xl font-display font-bold text-charcoal dark:text-bone mb-3 sm:mb-4 leading-tight tracking-tight group-hover:text-sage dark:group-hover:text-moss transition-colors duration-300">
                  {post.title}
                </h3>
                <div class="flex items-center gap-3 text-sm text-ash dark:text-[#B8C5D0] mb-4 font-medium">
                  <span>{post.author}</span>
                  <span class="text-stone/40 dark:text-white/20">·</span>
                  <time datetime={post.pubDate}>
                    {formatShortDate(post.pubDate)}
                  </time>
                </div>
                {post.excerpt && (
                  <p class="text-base text-ash dark:text-[#B8C5D0] leading-relaxed line-clamp-3">
                    {post.excerpt}
                  </p>
                )}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- By Author Sections - Editorial Style -->
    <section class="py-12 sm:py-16 md:py-20 px-4 bg-stone/20 dark:bg-white/5 border-t border-stone/30 dark:border-white/10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-charcoal dark:text-bone mb-12 sm:mb-16 pb-4 sm:pb-6 border-b border-stone/30 dark:border-white/10">
          By Author
        </h2>

          <div class="space-y-16">
            {feeds.filter(feed => feed.posts.length > 0).map((feed) => (
              <div class="bg-white rounded-[8px] p-8 shadow-lg">
                <div class="flex items-center gap-4 mb-6">
                  <h3 class="text-2xl font-display font-bold text-charcoal">
                    {feed.title}
                  </h3>
                  <a
                    href={`/articles?author=${encodeURIComponent(feed.title)}`}
                    class="text-sage hover:text-charcoal transition-colors text-sm font-medium"
                  >
                    View all →
                  </a>
                </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
                {feed.posts.slice(0, 3).map((post) => (
                  <article class="group">
                    <a href={post.link} target="_blank" rel="noopener noreferrer" class="block focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2 rounded-lg">
                      {post.image && (
                        <div class="relative aspect-[4/3] overflow-hidden rounded-lg mb-3 sm:mb-4">
                          <img 
                            src={post.image} 
                            alt={post.title || 'Article image'}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                            loading="lazy"
                            width="400"
                            height="300"
                          />
                        </div>
                      )}
                      <h4 class="text-base sm:text-lg md:text-xl font-display font-bold text-charcoal dark:text-bone mb-2 leading-tight tracking-tight group-hover:text-sage dark:group-hover:text-moss transition-colors duration-300 line-clamp-2">
                        {post.title}
                      </h4>
                      <time datetime={post.pubDate} class="text-sm text-ash dark:text-[#B8C5D0] font-medium">
                        {formatDate(post.pubDate)}
                      </time>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
