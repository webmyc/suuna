---
import Base from '../components/layout/Base.astro';
import { Image } from 'astro:assets';
import { fetchAllSubstackFeeds } from '../utils/substack';

// Page metadata
const title = 'Articles - SUUNA';
const description = 'Insights & reflections - Wisdom from our community of guides.';

// Fetch all Substack articles
const feeds = await fetchAllSubstackFeeds();

// Combine all posts and sort by date
const allPosts = feeds
  .flatMap(feed => feed.posts)
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

// Get featured article (most recent with image)
const featuredArticle = allPosts.find(post => post.image) || allPosts[0];

// Get latest articles (excluding featured)
const latestArticles = allPosts.filter(post => post !== featuredArticle).slice(0, 6);

// Get unique authors
const authors = [...new Set(allPosts.map(post => post.author))];
---

<Base title={title} description={description} canonical="https://suuna.ro/articles">
  <div class="min-h-screen bg-monk-bg">
    <!-- Hero Section -->
    <section class="relative pt-24 pb-12 px-4 border-b border-monk-border">
      <div class="max-w-6xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-display font-bold text-monk-text-primary mb-4 tracking-tight">
          Insights & Reflections
        </h1>
        <p class="text-xl text-monk-text-secondary max-w-2xl">
          Wisdom from our community of guides.
        </p>
      </div>
    </section>

    <!-- Featured Article -->
    {featuredArticle && (
      <article class="relative border-b border-monk-border">
        <a href={featuredArticle.link} target="_blank" rel="noopener noreferrer" class="block group">
          <div class="max-w-6xl mx-auto px-4 py-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
              {featuredArticle.image && (
                <div class="relative aspect-[4/3] overflow-hidden rounded-lg">
                  <img 
                    src={featuredArticle.image} 
                    alt={featuredArticle.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
              <div class={featuredArticle.image ? '' : 'lg:col-span-2'}>
                <div class="text-sm font-medium text-monk-accent mb-3 uppercase tracking-wide">
                  Featured
                </div>
                <h2 class="text-4xl md:text-5xl font-display font-bold text-monk-text-primary mb-4 leading-tight group-hover:text-monk-accent transition-colors">
                  {featuredArticle.title}
                </h2>
                <div class="flex items-center gap-4 text-sm text-monk-text-secondary mb-6">
                  <span class="font-medium">{featuredArticle.author}</span>
                  <span>·</span>
                  <time datetime={featuredArticle.pubDate}>
                    {new Date(featuredArticle.pubDate).toLocaleDateString('en-US', { 
                      month: 'long', 
                      day: 'numeric', 
                      year: 'numeric' 
                    })}
                  </time>
                </div>
                {featuredArticle.excerpt && (
                  <p class="text-lg text-monk-text-secondary leading-relaxed line-clamp-4">
                    {featuredArticle.excerpt}
                  </p>
                )}
              </div>
            </div>
          </div>
        </a>
      </article>
    )}

    <!-- Latest Articles - 2 Column Editorial Layout -->
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-display font-bold text-monk-text-primary mb-12 pb-4 border-b border-monk-border">
          Latest
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
          {latestArticles.map((post) => (
            <article class="group">
              <a href={post.link} target="_blank" rel="noopener noreferrer" class="block">
                {post.image && (
                  <div class="relative aspect-[16/9] overflow-hidden rounded-lg mb-4">
                    <img 
                      src={post.image} 
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                )}
                <h3 class="text-2xl font-display font-bold text-monk-text-primary mb-3 leading-tight group-hover:text-monk-accent transition-colors">
                  {post.title}
                </h3>
                <div class="flex items-center gap-3 text-sm text-monk-text-secondary mb-3">
                  <span class="font-medium">{post.author}</span>
                  <span>·</span>
                  <time datetime={post.pubDate}>
                    {new Date(post.pubDate).toLocaleDateString('en-US', { 
                      month: 'short', 
                      day: 'numeric' 
                    })}
                  </time>
                </div>
                {post.excerpt && (
                  <p class="text-monk-text-secondary leading-relaxed line-clamp-3">
                    {post.excerpt}
                  </p>
                )}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- By Author Sections -->
    <section class="py-16 px-4 bg-white border-t border-monk-border">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-display font-bold text-monk-text-primary mb-12 pb-4 border-b border-monk-border">
          By Author
        </h2>

        <div class="space-y-20">
          {feeds.filter(feed => feed.posts.length > 0).map((feed) => (
            <div>
              <div class="flex items-baseline justify-between mb-8">
                <h3 class="text-2xl font-display font-bold text-monk-text-primary">
                  {feed.title}
                </h3>
                <a
                  href={feed.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-monk-accent hover:underline"
                >
                  Subscribe →
                </a>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {feed.posts.slice(0, 3).map((post) => (
                  <article class="group">
                    <a href={post.link} target="_blank" rel="noopener noreferrer" class="block">
                      {post.image && (
                        <div class="relative aspect-[4/3] overflow-hidden rounded-lg mb-3">
                          <img 
                            src={post.image} 
                            alt={post.title}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                        </div>
                      )}
                      <h4 class="text-lg font-display font-bold text-monk-text-primary mb-2 leading-tight group-hover:text-monk-accent transition-colors line-clamp-2">
                        {post.title}
                      </h4>
                      <time datetime={post.pubDate} class="text-sm text-monk-text-secondary">
                        {new Date(post.pubDate).toLocaleDateString('en-US', { 
                          month: 'short', 
                          day: 'numeric',
                          year: 'numeric'
                        })}
                      </time>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
