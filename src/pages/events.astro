---
import Base from '../components/layout/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Events - SUUNA';
const description = 'Join our community gatherings, workshops, and transformative experiences. Discover upcoming SUUNA events.';
---

<Base 
  title={title}
  description={description}
  canonical="https://suuna.ro/events"
>
  <Header />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-suuna-text-light mb-6">
            Community Events
          </h1>
          <p class="text-xl text-suuna-text-muted max-w-3xl mx-auto">
            Join our community gatherings, workshops, and transformative experiences. 
            Connect with like-minded individuals and grow together.
          </p>
        </div>
      </div>
    </section>

    <!-- Events Calendar -->
    <section class="py-16 bg-gradient-to-b from-suuna-forest to-suuna-bg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="glass rounded-xl p-8 max-w-5xl mx-auto">
            <div class="text-center mb-8">
              <h2 class="text-2xl font-serif font-semibold text-suuna-text-light mb-4">
                SUUNA Community Calendar
              </h2>
              <p class="text-suuna-text-muted">
                Discover upcoming events and join our community gatherings
              </p>
            </div>
            
            <!-- Luma Calendar Embed -->
            <div class="flex justify-center">
              <iframe
                src="https://luma.com/embed/calendar/cal-rx0Dc6lhU837mI3/events"
                width="800"
                height="600"
                frameborder="0"
                style="border: 1px solid rgba(191, 203, 218, 0.53); border-radius: 8px;"
                allowfullscreen=""
                aria-hidden="false"
                tabindex="0"
                class="w-full max-w-4xl"
              ></iframe>
            </div>
            
            <div class="text-center mt-8">
              <a 
                href="https://lu.ma/suuna"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex items-center px-6 py-3 rounded-lg font-medium transition-all duration-300 hover:scale-105"
              >
                View All Events on Luma
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <h2 class="text-3xl font-serif font-bold text-suuna-text-light mb-6">
            Ready to join our community?
          </h2>
          <p class="text-xl text-suuna-text-muted mb-8">
            Connect with facilitators, attend workshops, and be part of our growing ecosystem.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="https://suuna.org"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-300 hover:scale-105"
            >
              Join SUUNA Platform
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            
            <a 
              href="/facilitators"
              class="btn-secondary inline-flex items-center px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-300 hover:scale-105"
            >
              Meet Our Facilitators
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<style>
  @import '../styles/fonts.css';
  @import '../styles/theme.css';
  @import '../styles/reveal.css';
</style>
