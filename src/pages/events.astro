---
import Base from '../components/layout/Base.astro';

// Page metadata
const title = 'Events - SUUNA';
const description = 'Gatherings, workshops, and sacred spaces. Join our community events.';
---

<Base title={title} description={description} canonical="https://suuna.ro/events">
  <div class="min-h-screen bg-bone">
    <!-- Hero Section -->
    <section class="relative pt-36 pb-20 px-4 bg-gradient-to-br from-bone via-white to-terracotta/10 overflow-hidden">
      <!-- Subtle organic background -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/4 w-80 h-80 bg-gradient-to-br from-terracotta/15 to-clay/5 rounded-full blur-3xl animate-breathe-slow"></div>
        <div class="absolute bottom-10 right-1/4 w-72 h-72 bg-gradient-to-br from-sage/10 to-moss/5 rounded-full blur-3xl animate-breathe-slow" style="animation-delay: 2s;"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-charcoal mb-8 leading-tight">
          Community Events
        </h1>
        <p class="text-xl md:text-2xl text-ash max-w-2xl mx-auto leading-relaxed font-light">
          Gatherings, workshops, and sacred spaces.
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-terracotta to-clay mx-auto rounded-full mt-8"></div>
      </div>
    </section>

    <!-- Luma Calendar Embed -->
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl shadow-terracotta/10 overflow-hidden border border-terracotta/10">
          <iframe
            src="https://lu.ma/embed/calendar/cal-abc123/events"
            width="100%"
            height="800"
            frameborder="0"
            style="border: none; border-radius: 1.5rem;"
            title="SUUNA Community Events Calendar"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-24 px-4 bg-gradient-to-br from-terracotta via-clay to-terracotta overflow-hidden">
      <!-- Organic background elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-white/5 rounded-full blur-3xl animate-float" style="animation-duration: 10s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-honey/20 rounded-full blur-3xl animate-float" style="animation-duration: 12s; animation-delay: 2s;"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-display font-semibold text-white mb-6 leading-tight">
          Host an Event?
        </h2>
        <p class="text-lg md:text-xl text-white/90 mb-12 max-w-2xl mx-auto leading-relaxed font-light">
          Add your event to Luma and submit it to the community calendar.
        </p>
        <a
          href="https://lu.ma/suuna"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-terracotta font-semibold rounded-2xl transition-all duration-300 hover:bg-bone hover:scale-105 shadow-xl shadow-clay/30"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Add Your Event</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>
