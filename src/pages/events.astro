---
import Base from '../components/layout/Base.astro';

// Page metadata
const title = 'Events - SUUNA';
const description = 'Gatherings, workshops, and sacred spaces. Join our community events.';
---

<Base title={title} description={description} canonical="https://suuna.ro/events">
  <div class="min-h-screen bg-bone">
    <!-- Hero Section - Bold and Warm -->
    <section class="relative pt-40 pb-28 px-4 bg-gradient-to-br from-bone via-white to-terracotta/10 overflow-hidden">
      <!-- Bold organic background with real depth -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/4 w-[550px] h-[550px] bg-gradient-to-br from-terracotta/18 to-clay/8 rounded-full blur-[120px] animate-float-slow"></div>
        <div class="absolute bottom-10 right-1/4 w-[500px] h-[500px] bg-gradient-to-br from-sage/12 to-moss/6 rounded-full blur-[120px] animate-float-slower"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] gradient-radial from-honey/8 to-transparent rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-display font-semibold text-charcoal mb-10 leading-none tracking-tight"
            style="text-shadow: 0 4px 30px rgba(212, 120, 92, 0.15);">
          Community Events
        </h1>
        <p class="text-2xl sm:text-3xl md:text-4xl text-ash max-w-3xl mx-auto leading-relaxed font-light mb-10">
          Gatherings, workshops, and sacred spaces.
        </p>
        <div class="w-32 h-2 bg-gradient-to-r from-terracotta via-clay to-terracotta mx-auto rounded-full shadow-lg shadow-terracotta/30"></div>
      </div>
    </section>

    <!-- Luma Calendar Embed - Elevated -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="bg-white dark:bg-[#1E2B38] rounded-3xl shadow-lg border border-stone/30 dark:border-white/10 overflow-hidden">
          <div class="p-16 text-center">
            <svg class="w-20 h-20 mx-auto mb-6 text-sage dark:text-moss" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <h2 class="text-3xl font-display font-bold text-charcoal dark:text-bone mb-4">
              Events Coming Soon
            </h2>
            <p class="text-lg text-ash dark:text-[#B8C5D0] max-w-2xl mx-auto mb-8">
              We're preparing something special for our community. Check back soon for upcoming workshops, gatherings, and sacred spaces.
            </p>
            <a
              href="https://lu.ma/suuna"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 bg-sage dark:bg-moss text-white font-semibold rounded-xl hover:bg-forest-dark dark:hover:bg-sage transition-all"
            >
              Stay Updated
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section - Bold and Inviting -->
    <section class="relative py-32 px-4 bg-gradient-to-br from-terracotta via-clay to-terracotta overflow-hidden">
      <!-- Large organic background elements with real depth -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-white/8 rounded-full blur-[120px] animate-float" style="animation-duration: 10s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-honey/25 rounded-full blur-[120px] animate-float" style="animation-duration: 12s; animation-delay: 2s;"></div>
        <div class="absolute top-1/2 right-1/3 w-[400px] h-[400px] bg-white/5 rounded-full blur-3xl animate-breathe-slow"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-white mb-8 leading-tight tracking-tight"
            style="text-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);">
          Host an Event?
        </h2>
        <p class="text-xl sm:text-2xl lg:text-3xl text-white/95 max-w-3xl mx-auto mb-16 leading-relaxed font-light">
          Add your event to Luma and submit it to the community calendar.
        </p>
        <a
          href="https://lu.ma/suuna"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 px-12 py-6 bg-white text-terracotta font-bold text-lg rounded-[28px] transition-all duration-300 hover:bg-bone hover:scale-105 shadow-2xl shadow-clay/40 hover:shadow-2xl hover:shadow-clay/50"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Add Your Event</span>
          <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>
