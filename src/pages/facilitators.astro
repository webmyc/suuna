---
import Base from '../components/layout/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

// Get all facilitators
const facilitators = await getCollection('facilitators');
const sortedFacilitators = facilitators.sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = 'Facilitators - SUUNA';
const description = 'Meet the visionary teachers, healers, and community builders who are co-creating intentional spaces for transformation and growth.';
---

<Base 
  title={title}
  description={description}
  canonical="https://suuna.ro/facilitators"
>
  <Header />
  
  <main class="min-h-screen bg-bone">
    <!-- Hero Section -->
    <section class="relative pt-36 pb-20 px-4 bg-gradient-to-br from-bone via-white to-moss/10 overflow-hidden">
      <!-- Subtle organic background -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/3 w-80 h-80 bg-gradient-to-br from-moss/15 to-sage/10 rounded-full blur-3xl animate-breathe-slow"></div>
        <div class="absolute bottom-10 right-1/3 w-72 h-72 bg-gradient-to-br from-honey/15 to-terracotta/5 rounded-full blur-3xl animate-breathe-slow" style="animation-delay: 1.5s;"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-charcoal mb-8 leading-tight">
          <span class="font-suuna" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span> Family of Creators
        </h1>
        <p class="text-xl md:text-2xl text-ash max-w-3xl mx-auto leading-relaxed font-light">
          Meet the visionary teachers, healers, and community builders who are co-creating intentional spaces for transformation and growth.
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-moss to-sage mx-auto rounded-full mt-8"></div>
      </div>
    </section>

    <!-- Facilitators Grid -->
    <section class="py-16 bg-gradient-to-b from-suuna-forest to-suuna-bg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedFacilitators.map((facilitator) => (
            <div class="reveal-stagger">
              <article class="card p-6 group h-full">
                <div class="aspect-square mb-6 overflow-hidden rounded-lg">
                  <img 
                    src={facilitator.data.image} 
                    alt={facilitator.data.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                
                <h3 class="text-xl font-serif font-semibold text-suuna-text-light mb-2 group-hover:text-suuna-accent transition-colors">
                  {facilitator.data.name}
                </h3>
                
                <p class="text-suuna-accent font-medium mb-3">
                  {facilitator.data.role}
                </p>
                
                <p class="text-suuna-text-muted text-sm mb-4 line-clamp-3">
                  {facilitator.data.bio.substring(0, 150)}...
                </p>
                
                <div class="flex items-center justify-between mt-auto">
                  <span class="text-xs text-suuna-text-muted">
                    📍 {facilitator.data.location}
                  </span>
                  <a 
                    href={`/facilitators/${facilitator.slug}`}
                    class="text-suuna-accent hover:text-suuna-accent-muted text-sm font-medium transition-colors"
                  >
                    View Profile →
                  </a>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<style>
  @import '../styles/fonts.css';
  @import '../styles/theme.css';
  @import '../styles/reveal.css';
</style>
