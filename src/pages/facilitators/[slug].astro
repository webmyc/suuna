---
import Base from '../../components/layout/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const facilitators = await getCollection('facilitators');
  return facilitators.map((facilitator) => ({
    params: { slug: facilitator.slug },
    props: { facilitator },
  }));
}

const { facilitator } = Astro.props;
const { Content } = await facilitator.render();

const title = `${facilitator.data.name} - SUUNA Facilitator`;
const description = facilitator.data.bio.substring(0, 160) + '...';
---

<Base 
  title={title}
  description={description}
  canonical={`https://suuna.ro/facilitators/${facilitator.slug}`}
>
  <Header />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-bg to-suuna-forest">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal">
            <div class="aspect-square max-w-md mx-auto lg:mx-0 overflow-hidden rounded-2xl">
              <img 
                src={facilitator.data.image} 
                alt={facilitator.data.name}
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          </div>
          
          <div class="reveal-stagger">
            <h1 class="text-4xl md:text-5xl font-serif font-bold text-suuna-text-light mb-4">
              {facilitator.data.name}
            </h1>
            
            <p class="text-xl text-suuna-accent font-semibold mb-6">
              {facilitator.data.role}
            </p>
            
            <div class="flex items-center mb-8">
              <span class="text-suuna-text-muted">
                📍 {facilitator.data.location}
              </span>
            </div>
            
            <div class="flex flex-wrap gap-4">
              {facilitator.data.website && (
                <a 
                  href={facilitator.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary inline-flex items-center px-6 py-3 rounded-lg font-medium transition-all duration-300 hover:scale-105"
                >
                  Visit Website
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              )}
              
              {facilitator.data.substack && (
                <a 
                  href={facilitator.data.substack}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary inline-flex items-center px-6 py-3 rounded-lg font-medium transition-all duration-300 hover:scale-105"
                >
                  Read on Substack
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="py-16 bg-gradient-to-b from-suuna-forest to-suuna-bg">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="prose prose-lg prose-invert max-w-none">
            <Content />
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<style>
  .prose {
    color: var(--suuna-text-light);
  }
  
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: var(--suuna-text-light);
    font-family: 'PT Serif', serif;
  }
  
  .prose a {
    color: var(--suuna-accent);
  }
  
  .prose a:hover {
    color: var(--suuna-accent-muted);
  }
  
  .prose strong {
    color: var(--suuna-text-light);
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{facilitator.data.name}",
    "jobTitle": "{facilitator.data.role}",
    "description": "{facilitator.data.bio}",
    "url": "https://suuna.ro/facilitators/{facilitator.slug}",
    "image": "https://suuna.ro{facilitator.data.image}",
    "sameAs": [
      {facilitator.data.website ? `"${facilitator.data.website}"` : ''},
      {facilitator.data.substack ? `"${facilitator.data.substack}"` : ''}
    ].filter(Boolean)
  }
</script>
