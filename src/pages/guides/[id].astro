---
import Base from '../../components/layout/Base.astro';
import guidesData from '../../../data/facilitators.json';
import offeringsData from '../../../data/offerings.json';

export async function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;

// Get offerings for this guide
const guideOfferings = offeringsData.filter(o => o.guide_id === guide.id);

// Get links
const siteLink = guide.links?.find(l => l.type === 'site');
const substackLink = guide.links?.find(l => l.type === 'substack');
const lumaLink = guide.links?.find(l => l.type === 'luma');
const calendarLink = guide.links?.find(l => l.type === 'calendar');

// Page metadata
const title = `${guide.name} - SUUNA Guide`;
const description = guide.bio || guide.headline;
---

<Base title={title} description={description} canonical={`https://suuna.ro/guides/${guide.id}`}>
  <div class="min-h-screen bg-bone">
    <!-- Hero Section - Bold and Present -->
    <section class="relative pt-36 pb-20 px-4 bg-gradient-to-br from-bone via-white to-sage/10 overflow-hidden">
      <!-- Bold organic background -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 right-1/4 w-[500px] h-[500px] bg-gradient-to-br from-sage/15 to-moss/8 rounded-full blur-[120px] animate-float-slow"></div>
        <div class="absolute bottom-10 left-1/4 w-[450px] h-[450px] bg-gradient-to-br from-terracotta/12 to-honey/8 rounded-full blur-[120px] animate-float-slower"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row gap-12 items-start">
          <!-- Guide Photo - Large and Bold -->
          <div class="w-full md:w-2/5">
            <div class="aspect-square rounded-[8px] overflow-hidden shadow-2xl shadow-sage/20 ring-4 ring-white/50">
              <img
                src={guide.image}
                alt={guide.name}
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          </div>

          <!-- Guide Info -->
          <div class="flex-1">
            <h1 class="text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-charcoal mb-6 leading-none tracking-tight">
              {guide.name}
            </h1>

            <p class="text-2xl sm:text-3xl text-terracotta font-semibold mb-8">
              {guide.headline}
            </p>

            {guide.location && (
              <div class="flex items-center gap-3 text-xl text-ash mb-10">
                <svg class="w-7 h-7 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="font-medium">{guide.location}</span>
              </div>
            )}

            <!-- Tags -->
            {guide.tags && guide.tags.length > 0 && (
              <div class="flex flex-wrap gap-3 mb-10">
                {guide.tags.map((tag: string) => (
                  <span class="px-5 py-3 bg-stone/50 text-charcoal rounded-[8px] text-base font-semibold border-2 border-sage/20">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <!-- Action Buttons - Bold and Inviting -->
            <div class="flex flex-wrap gap-4">
              {siteLink && (
                <a
                  href={siteLink.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-br from-sage to-forest text-white font-bold text-lg rounded-[8px] hover:shadow-2xl hover:shadow-sage/40 transition-all duration-300 hover:scale-105 shadow-xl shadow-sage/30"
                >
                  <svg class="w-6 h-6 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                  </svg>
                  <span class="group-hover:scale-105 transition-transform duration-300">Visit Website</span>
                </a>
              )}

              {substackLink && (
                <a
                  href={substackLink.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-3 px-10 py-5 bg-white/95 backdrop-blur-sm border-3 border-sage/40 text-sage hover:bg-white hover:border-sage/60 font-bold text-lg rounded-[8px] transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl"
                >
                  <svg class="w-6 h-6 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <span class="group-hover:scale-105 transition-transform duration-300">Subscribe</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Biography - Generous and Readable -->
    <section class="py-16 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-charcoal mb-10 leading-tight tracking-tight">
          About {guide.name}
        </h2>
        <div class="prose prose-xl max-w-none">
          <p class="text-xl leading-relaxed text-ash whitespace-pre-line">
            {guide.bio}
          </p>
        </div>
      </div>
    </section>

    <!-- Offerings - If Available -->
    {guideOfferings.length > 0 && (
      <section class="py-16 px-4 bg-gradient-to-br from-stone/30 to-bone">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-charcoal mb-12 leading-tight tracking-tight text-center">
            Offerings
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {guideOfferings.map((offering) => (
              <article class="group bg-white/95 backdrop-blur-sm rounded-[8px] overflow-hidden shadow-xl shadow-terracotta/10 hover:shadow-2xl hover:shadow-terracotta/20 transition-all duration-500 hover:-translate-y-2">
                {/* Offering Image */}
                <div class="aspect-video bg-gradient-to-br from-terracotta to-clay relative overflow-hidden">
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-white text-center p-8">
                      <div class="text-7xl mb-4 animate-breathe-slow">✨</div>
                      <p class="text-lg opacity-90 font-medium">{offering.type}</p>
                    </div>
                  </div>
                </div>

                {/* Offering Info */}
                <div class="p-8">
                  <div class="flex items-center gap-2 mb-4">
                    <span class="px-4 py-2 bg-terracotta/10 text-terracotta rounded-[8px] text-sm font-bold capitalize">
                      {offering.type}
                    </span>
                    <span class="text-ash text-sm font-medium">
                      {new Date(offering.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                  </div>

                  <h3 class="text-2xl sm:text-3xl font-display font-bold text-charcoal mb-4 group-hover:text-terracotta transition-colors leading-tight">
                    {offering.title}
                  </h3>

                  <p class="text-lg text-ash mb-6 leading-relaxed">
                    {offering.description}
                  </p>

                  <a
                    href={offering.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/button inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-br from-terracotta to-clay text-white font-bold text-base rounded-[8px] hover:shadow-xl hover:shadow-terracotta/40 transition-all duration-300 hover:scale-105 shadow-lg"
                  >
                    <span class="group-hover/button:scale-105 transition-transform duration-300">Learn More</span>
                    <svg class="w-5 h-5 group-hover/button:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Newsletter CTA - If Substack -->
    {substackLink && (
      <section class="py-16 px-4 bg-white">
        <div class="max-w-4xl mx-auto">
          <div class="bg-gradient-to-br from-sage/10 to-moss/5 rounded-[8px] p-10 md:p-14 shadow-xl shadow-sage/10 border-2 border-sage/20">
            <h2 class="text-4xl sm:text-5xl font-display font-semibold text-charcoal mb-6 leading-tight">
              Subscribe to {guide.name}'s Newsletter
            </h2>
            <p class="text-xl text-ash mb-8 leading-relaxed">
              Get regular insights, updates, and wisdom delivered to your inbox.
            </p>

            <a
              href={substackLink.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-br from-sage to-forest text-white font-bold text-lg rounded-[8px] hover:shadow-xl hover:shadow-sage/40 transition-all duration-300 hover:scale-105 shadow-lg"
            >
              <svg class="w-6 h-6 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="group-hover:scale-105 transition-transform duration-300">Subscribe on Substack</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Back to Guides -->
    <section class="py-16 px-4 bg-bone">
      <div class="max-w-4xl mx-auto text-center">
        <a
          href="/guides"
          class="group inline-flex items-center gap-3 text-sage hover:text-forest transition-colors font-bold text-lg"
        >
          <svg class="w-6 h-6 group-hover:-translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
          </svg>
          <span class="group-hover:scale-105 transition-transform duration-300">Back to All Guides</span>
        </a>
      </div>
    </section>
  </div>
</Base>
