---
import Base from '../components/layout/Base.astro';
import Hero from '../components/sections/Hero.astro';

// Page metadata
const title = 'SUUNA - Learning from nature, together';
const description = 'Community platform for wisdom creators, facilitators, and intentional communities. Join SUUNA to amplify your message and grow your community.';
---

<Base title={title} description={description} canonical="https://suuna.ro">
  <Hero />

  <!-- Community Section -->
  <section id="discover" class="py-24 bg-secondary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 animate-fade-in">
        <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">
          Join the <span class="font-suuna text-accent" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span> Community
        </h2>
        <p class="text-xl text-secondary max-w-2xl mx-auto">
          Whether you're a facilitator, wisdom keeper, or seeking connection with intentional communities,
          there's a place for you here.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a
          href="https://lu.ma/suuna"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-white font-semibold rounded-full transition-all hover:scale-105 hover:shadow-lg"
        >
          Explore Events
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>

        <a
          href="https://suuna.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-accent text-accent font-semibold rounded-full transition-all hover:bg-accent/10"
        >
          Visit SUUNA.org
        </a>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-24 bg-primary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Events -->
        <div class="glass p-8 rounded-3xl hover-lift">
          <div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-3">Events & Workshops</h3>
          <p class="text-secondary">
            Join transformative gatherings, workshops, and community experiences.
          </p>
        </div>

        <!-- Facilitators -->
        <div class="glass p-8 rounded-3xl hover-lift">
          <div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-3">Facilitators</h3>
          <p class="text-secondary">
            Connect with wisdom keepers, healers, and guides from our community.
          </p>
        </div>

        <!-- Content -->
        <div class="glass p-8 rounded-3xl hover-lift">
          <div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-3">Articles & Wisdom</h3>
          <p class="text-secondary">
            Explore insights, stories, and teachings from our community contributors.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
