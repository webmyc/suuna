---
import Base from '../components/layout/Base.astro';
import Hero from '../components/sections/Hero.astro';
import { EventsCarousel } from '../components/sections/EventsCarousel';
import { FacilitatorsCarousel } from '../components/sections/FacilitatorsCarousel';
import { DiscoverGrid } from '../components/sections/DiscoverGrid';

// Load data
import eventsData from '../data/events.json';
import facilitatorsData from '../data/facilitators.json';
import articlesData from '../data/articles.json';

// Page metadata
const title = 'SUUNA - Learning from nature, together';
const description = 'Community platform for wisdom creators, facilitators, and intentional communities. Join SUUNA to amplify your message and grow your community.';
---

<Base title={title} description={description} canonical="https://suuna.ro">
  <Hero />

  <!-- What is SUUNA? Section -->
  <section class="py-24 px-4 bg-white">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-forest-dark mb-6">
          Where communities breathe together
        </h2>
        <p class="text-xl text-ash max-w-3xl mx-auto leading-relaxed">
          A distraction-free space where teachers, facilitators, and wisdom keepers come together to share their work and grow alongside their learners.
        </p>
      </div>

      <!-- Three Principles -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
        <article class="text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-sage/10 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-display font-bold text-forest-dark mb-4">
            Presence Over Performance
          </h3>
          <p class="text-ash leading-relaxed">
            Your being here is the contribution.
          </p>
        </article>

        <article class="text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-terracotta/10 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-display font-bold text-forest-dark mb-4">
            Horizontal Relationships
          </h3>
          <p class="text-ash leading-relaxed">
            Peers alongside peers, not above or below.
          </p>
        </article>

        <article class="text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-honey/20 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-clay" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-display font-bold text-forest-dark mb-4">
            Do You Feel Beneficial?
          </h3>
          <p class="text-ash leading-relaxed">
            The only metric that matters.
          </p>
        </article>
      </div>

      <div class="text-center">
        <a
          href="/manifesto"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-sage text-sage hover:bg-sage hover:text-white rounded-full font-medium transition-all hover:scale-105"
        >
          Read Our Manifesto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Carousel -->
  <EventsCarousel client:load events={eventsData} />

  <!-- Facilitators Carousel -->
  <FacilitatorsCarousel client:load facilitators={facilitatorsData} />

  <!-- Discover Grid with Filtering -->
  <DiscoverGrid
    client:load
    events={eventsData}
    facilitators={facilitatorsData}
    articles={articlesData}
  />

  <!-- Community CTA -->
  <section class="py-24 bg-secondary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-fade-in">
        <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">
          Join the <span class="font-suuna text-accent" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span> Community
        </h2>
        <p class="text-xl text-secondary max-w-2xl mx-auto mb-8">
          Whether you're a facilitator, wisdom keeper, or seeking connection with intentional communities,
          there's a place for you here.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a
          href="https://lu.ma/suuna"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-white font-semibold rounded-full transition-all hover:scale-105 hover:shadow-lg"
        >
          Explore More Events
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>

        <a
          href="https://suuna.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-accent text-accent font-semibold rounded-full transition-all hover:bg-accent/10"
        >
          Visit SUUNA.org
        </a>
      </div>
    </div>
  </section>
</Base>
