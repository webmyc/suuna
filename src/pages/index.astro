---
import Base from '../components/layout/Base.astro';
import Hero from '../components/sections/Hero.astro';
import { EventsCarousel } from '../components/sections/EventsCarousel';
import { FacilitatorsCarousel } from '../components/sections/FacilitatorsCarousel';
import { DiscoverGrid } from '../components/sections/DiscoverGrid';

// Load data
import eventsData from '../data/events.json';
import facilitatorsData from '../data/facilitators.json';
import articlesData from '../data/articles.json';

// Page metadata
const title = 'SUUNA - A Platform for Intentional Communities';
const description = 'Community platform for wisdom creators, facilitators, and intentional communities. Join SUUNA to amplify your message and grow your community.';
---

<Base title={title} description={description} canonical="https://suuna.ro">
  <Hero />

  <!-- What is SUUNA? Section -->
  <section class="py-20 px-4 bg-stone/30">
    <div class="mx-auto max-w-5xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-charcoal mb-4">
          Where communities breathe together
        </h2>
        <p class="text-base md:text-lg text-charcoal/60 max-w-2xl mx-auto">
          A distraction-free space where teachers, facilitators, and wisdom keepers share their work and grow alongside their learners.
        </p>
      </div>

      <!-- Three Principles -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
        <article class="text-center px-4">
          <div class="w-16 h-16 mx-auto mb-5 bg-white border border-sage/20 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-charcoal mb-2">
            Presence Over Performance
          </h3>
          <p class="text-sm text-charcoal/60">
            Your being here is the contribution.
          </p>
        </article>

        <article class="text-center px-4">
          <div class="w-16 h-16 mx-auto mb-5 bg-white border border-terracotta/20 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-charcoal mb-2">
            Horizontal Relationships
          </h3>
          <p class="text-sm text-charcoal/60">
            Peers alongside peers, not above or below.
          </p>
        </article>

        <article class="text-center px-4">
          <div class="w-16 h-16 mx-auto mb-5 bg-white border border-honey/30 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-clay" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-charcoal mb-2">
            Do You Feel Beneficial?
          </h3>
          <p class="text-sm text-charcoal/60">
            The only metric that matters.
          </p>
        </article>
      </div>

      <div class="text-center">
        <a
          href="/manifesto"
          class="inline-flex items-center gap-2 px-6 py-2.5 border border-charcoal/15 text-charcoal hover:border-sage hover:text-sage rounded-md font-medium transition-all"
        >
          Read Our Manifesto
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Carousel -->
  <EventsCarousel client:load events={eventsData} />

  <!-- Facilitators Carousel -->
  <FacilitatorsCarousel client:load facilitators={facilitatorsData} />

  <!-- Discover Grid with Filtering -->
  <DiscoverGrid
    client:load
    events={eventsData}
    facilitators={facilitatorsData}
    articles={articlesData}
  />

  <!-- Community CTA -->
  <section class="py-20 px-4 bg-white border-t border-stone">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-2xl md:text-3xl font-display font-semibold text-charcoal mb-4">
        Join the SUUNA Community
      </h2>
      <p class="text-base text-charcoal/60 max-w-xl mx-auto mb-8">
        Whether you're a facilitator, wisdom keeper, or seeking connection with intentional communities.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a
          href="/join"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-sage text-white font-medium rounded-md transition-all hover:bg-forest-dark"
        >
          Join as Member
        </a>
        <a
          href="/join#guides"
          class="inline-flex items-center gap-2 px-6 py-2.5 border border-charcoal/15 text-charcoal font-medium rounded-md transition-all hover:border-sage hover:text-sage"
        >
          Become a Guide
        </a>
      </div>
    </div>
  </section>
</Base>
