---
import Base from '../components/layout/Base.astro';
import Hero from '../components/sections/Hero.astro';
import RecentArticles from '../components/sections/RecentArticles.astro';
import { EventsCarousel } from '../components/sections/EventsCarousel';
import { FacilitatorsCarousel } from '../components/sections/FacilitatorsCarousel';
import IndividualSubstack from '../components/sections/IndividualSubstack.astro';

// Load data
import eventsData from '../data/events.json';
import facilitatorsData from '../data/facilitators.json';

// Page metadata
const title = 'SUUNA - Discover Wisdom, Events & Community';
const description = 'Explore transformative events, wisdom from facilitators, and articles on embodiment, nature connection, and conscious living. Your gateway to the SUUNA community.';
---

<Base title={title} description={description} canonical="https://suuna.ro">
  <!-- Hero Section: Discovery-focused -->
  <Hero />

  <!-- Latest Wisdom: 6 newest articles from ALL Substacks -->
  <RecentArticles />

  <!-- Upcoming Events -->
  <section id="events" class="py-16 md:py-24 bg-secondary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-primary mb-4">
          Upcoming Events
        </h2>
        <p class="text-lg md:text-xl text-secondary max-w-2xl mx-auto">
          Join us for transformative gatherings, workshops, and community experiences
        </p>
      </div>
      <EventsCarousel client:load events={eventsData} />
    </div>
  </section>

  <!-- Individual Facilitator Sections -->

  <!-- Dana Dragomirescu: Ecology of Emotions -->
  <IndividualSubstack
    url="https://danadragomirescu.substack.com"
    authorName="Dana Dragomirescu"
    sectionTitle="Ecology of Emotions with Dana Dragomirescu"
  />

  <!-- Melissa Louise: Pleasure Advocate -->
  <IndividualSubstack
    url="https://melissalouise.substack.com"
    authorName="Melissa Louise"
    sectionTitle="Embodied Pleasure with Melissa Louise"
  />

  <!-- Laura Maria Yara: Womb Oracle & Feminine Guide -->
  <IndividualSubstack
    url="https://lauramariayara.substack.com"
    authorName="Laura Maria Yara"
    sectionTitle="Womb Wisdom with Laura Maria Yara"
  />

  <!-- Reflector's Reflections: Human Design Guide -->
  <IndividualSubstack
    url="https://reflectorsreflections.substack.com"
    authorName="Reflector's Reflections"
    sectionTitle="Human Design Insights from Reflector's Reflections"
  />

  <!-- SUUNA Community Section -->
  <IndividualSubstack
    url="https://suuna.substack.com"
    authorName="SUUNA Community"
    sectionTitle="SUUNA Community Wisdom"
  />

  <!-- All Facilitators Overview -->
  <section id="facilitators" class="py-16 md:py-24 bg-primary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-primary mb-4">
          Meet Our Facilitators
        </h2>
        <p class="text-lg md:text-xl text-secondary max-w-2xl mx-auto">
          Connect with wisdom keepers, healers, and guides from our community
        </p>
      </div>
      <FacilitatorsCarousel client:load facilitators={facilitatorsData} />
    </div>
  </section>

  <!-- Community CTA -->
  <section class="py-24 bg-secondary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-fade-in">
        <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">
          Join the <span class="font-suuna text-accent" style="font-family: 'Architype Bayer-type W90', sans-serif !important;">SUUNA</span> Universe
        </h2>
        <p class="text-xl text-secondary max-w-2xl mx-auto mb-8">
          Subscribe to our newsletters, attend events, and connect with facilitators.
          Your journey into embodiment, nature connection, and conscious living starts here.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a
          href="https://suuna.substack.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-white font-semibold rounded-full transition-all hover:scale-105 hover:shadow-lg"
        >
          Subscribe to SUUNA
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>

        <a
          href="https://lu.ma/suuna"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-accent text-accent font-semibold rounded-full transition-all hover:bg-accent/10"
        >
          View All Events
        </a>
      </div>
    </div>
  </section>
</Base>
