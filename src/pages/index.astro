---
import Base from '../components/layout/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import RecentArticles from '../components/sections/RecentArticles.astro';
import IndividualSubstack from '../components/sections/IndividualSubstack.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import CoCreateSection from '../components/sections/CoCreateSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import SuunaHero from '../components/sections/SuunaHero.astro';

// Page metadata
const title = 'SUUNA - Learning from nature, together';
const description = 'Community platform for wisdom creators, facilitators, and intentional communities. Join SUUNA to amplify your message and grow your community.';
---

<Base 
  title={title}
  description={description}
  canonical="https://suuna.ro"
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center gradient-forest noise-overlay relative overflow-hidden">
      <!-- Background breathing circle -->
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 opacity-10">
        <div class="breathing-circle w-full h-full rounded-full border border-suuna-accent"></div>
      </div>
      
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <div class="reveal">
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold text-suuna-text-light mb-8 leading-tight">
            Bring your gifts to your community with <span class="suuna-font text-suuna-accent">SUUNA</span>
          </h1>
        </div>
        
        <div class="reveal-stagger max-w-4xl mx-auto space-y-6">
          <p class="text-xl md:text-2xl text-suuna-text-light leading-relaxed">
            At <span class="suuna-font">SUUNA</span>, we help creators amplify their message and grow their communities — 
            without the technical or marketing headaches.
          </p>
          
          <p class="text-lg text-suuna-accent font-semibold">
            You teach. We amplify.
          </p>
        </div>
        
        <div class="reveal mt-12 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#community"
            class="inline-flex items-center gap-3 px-8 py-4 bg-suuna-accent text-suuna-bg font-semibold text-lg rounded-full hover:bg-suuna-accent-muted transition-colors shadow-lg"
          >
            Join the Community
          </a>
          <a 
            href="https://suuna.org"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 border-2 border-suuna-accent text-suuna-accent font-semibold text-lg rounded-full hover:bg-suuna-accent/10 transition-colors shadow-lg"
          >
            Visit <span class="suuna-font">SUUNA</span>.org
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

           <!-- Substack Feeds Section -->
           <div id="community">
             <RecentArticles />
           </div>

           <!-- Individual Substack Sections -->
           <IndividualSubstack 
             url="https://suuna.substack.com" 
             authorName="SUUNA Community" 
             sectionTitle="SUUNA Community" 
           />
           
           <IndividualSubstack 
             url="https://danadragomirescu.substack.com" 
             authorName="Dana Dragomirescu" 
             sectionTitle="Ecology of Emotions" 
           />
           
           <IndividualSubstack 
             url="https://melissalouise.substack.com" 
             authorName="Melissa Louise" 
             sectionTitle="Pleasure Advocate" 
           />
           
           <IndividualSubstack 
             url="https://lauramariayara.substack.com" 
             authorName="Laura Maria Yara" 
             sectionTitle="Womb Oracle & Feminine Guide" 
           />
           
           <IndividualSubstack 
             url="https://reflectorsreflections.substack.com" 
             authorName="Reflector's Reflections" 
             sectionTitle="Reflector's Reflections" 
           />

    <!-- Events Section -->
    <EventsSection />

    <!-- Newsletter Section -->
    <NewsletterSection />

    <!-- Co-Create Section -->
    <CoCreateSection />

    <!-- SUUNA Hero Section (from respira.cafe/suuna) -->
    <SuunaHero />
         </main>

         <Footer />
</Base>

<style>
  @import '../styles/fonts.css';
  @import '../styles/theme.css';
  @import '../styles/reveal.css';
</style>
