---
import Base from '../components/layout/Base.astro';
import Hero from '../components/sections/Hero.astro';
import { EventsCarousel } from '../components/sections/EventsCarousel';
import { FacilitatorsCarousel } from '../components/sections/FacilitatorsCarousel';
import { DiscoverGrid } from '../components/sections/DiscoverGrid';

// Load data
import eventsData from '../data/events.json';
import guidesData from '../data/facilitators.json';
import articlesData from '../data/articles.json';

// Page metadata
const title = 'SUUNA - A Platform for Intentional Communities';
const description = 'Community platform for wisdom creators, guides, and intentional communities. Join SUUNA to amplify your message and grow your community.';
---

<Base title={title} description={description} canonical="https://suuna.ro">
  <Hero />

  <!-- What is SUUNA? Section -->
  <section class="relative py-20 px-4 bg-bone dark:bg-[#0D1B22]">
    <div class="mx-auto max-w-6xl">
      <!-- Heading -->
      <div class="text-center mb-16">
        <h2 class="text-4xl sm:text-5xl font-display font-bold text-charcoal dark:text-bone mb-6 leading-tight">
          Where communities<br/>breathe together
        </h2>
        <p class="text-xl text-ash dark:text-[#B8C5D0] max-w-3xl mx-auto leading-relaxed">
          A distraction-free space where teachers, facilitators, and wisdom keepers share their work and grow alongside their learners.
        </p>
      </div>

      <!-- Three Principles -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <article class="text-center px-6 py-10 bg-white dark:bg-[#1E2B38] rounded-xl border border-stone/30 dark:border-white/10 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto mb-6 bg-sage/10 dark:bg-moss/20 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-sage dark:text-moss" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-charcoal dark:text-bone mb-3">
            Presence Over<br/>Performance
          </h3>
          <p class="text-base text-ash dark:text-[#B8C5D0] leading-relaxed">
            Your being here is<br/>the contribution.
          </p>
        </article>

        <article class="text-center px-6 py-10 bg-white dark:bg-[#1E2B38] rounded-xl border border-stone/30 dark:border-white/10 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto mb-6 bg-sage/10 dark:bg-moss/20 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-sage dark:text-moss" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-charcoal dark:text-bone mb-3">
            Horizontal<br/>Relationships
          </h3>
          <p class="text-base text-ash dark:text-[#B8C5D0] leading-relaxed">
            Peers alongside peers,<br/>not above or below.
          </p>
        </article>

        <article class="text-center px-6 py-10 bg-white dark:bg-[#1E2B38] rounded-xl border border-stone/30 dark:border-white/10 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto mb-6 bg-sage/10 dark:bg-moss/20 rounded-lg flex items-center justify-center">
            <svg class="w-8 h-8 text-sage dark:text-moss" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-charcoal dark:text-bone mb-3">
            Do You Feel<br/>Beneficial?
          </h3>
          <p class="text-base text-ash dark:text-[#B8C5D0] leading-relaxed">
            The only metric<br/>that matters.
          </p>
        </article>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a
          href="/manifesto"
          class="inline-flex items-center gap-2 px-8 py-3 bg-sage dark:bg-moss text-white font-semibold rounded-lg hover:bg-forest-dark dark:hover:bg-sage transition-all"
        >
          <span>Read Our Manifesto</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Carousel -->
  <EventsCarousel client:load events={eventsData} />

  <!-- Facilitators Carousel -->
  <FacilitatorsCarousel client:load guides={guidesData} />

  <!-- Discover Grid with Filtering -->
  <DiscoverGrid
    client:load
    events={eventsData}
    facilitators={guidesData}
    articles={articlesData}
  />

  <!-- Community CTA -->
  <section class="relative py-20 px-4 bg-charcoal dark:bg-[#1E2B38]">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-4xl sm:text-5xl font-display font-bold text-bone dark:text-bone mb-6 leading-tight">
        Join the SUUNA Community
      </h2>
      <p class="text-xl text-bone/90 dark:text-[#B8C5D0] max-w-3xl mx-auto mb-10 leading-relaxed">
        Whether you're a facilitator, wisdom keeper, or seeking connection with intentional communities.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/join"
          class="inline-flex items-center gap-2 px-8 py-4 bg-bone dark:bg-bone text-charcoal dark:text-charcoal font-bold rounded-lg hover:bg-stone dark:hover:bg-stone/20 transition-all"
        >
          <span>Join as Member</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="/join#guides"
          class="inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-bone dark:border-bone text-bone dark:text-bone font-semibold rounded-lg hover:bg-bone/10 dark:hover:bg-bone/10 transition-all"
        >
          <span>Become a Guide</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>
