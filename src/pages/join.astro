---
import Base from '../components/layout/Base.astro';

// Page metadata
const title = 'Join SUUNA - Find Your Place';
const description = 'Join the community as a learner or share your work as a guide. A free, intentional space to connect, learn, and contribute.';
---

<Base title={title} description={description} canonical="https://suuna.ro/join">
  <!-- SUUNA.org Widget Script -->
  <script is:inline>
    (function (w,d,s,o,f,js,fjs) {
        w['circleWidget']=o;w[o] = w[o] || function () { (w[o].q = w[o].q || []).push(arguments) };
        js = d.createElement(s), fjs = d.getElementsByTagName(s)[0];
        js.id = o; js.src = f; js.async = 1; fjs.parentNode.insertBefore(js, fjs);
    }(window, document, 'script', 'mw', 'https://www.suuna.org/external/widget.js'));
    mw('init', {
      community_public_uid: '615e3202',
      brand_color_dark: '#0D1B22',
      brand_color_light: '#1E2B38',
      default_appearance: 'dark'
    });
  </script>

  <div class="min-h-screen bg-bone">
    <!-- Hero Section -->
    <section class="relative pt-36 pb-20 px-4 bg-gradient-to-br from-bone via-white to-moss/10 overflow-hidden">
      <!-- Subtle organic background -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 right-1/4 w-80 h-80 bg-gradient-to-br from-moss/15 to-sage/10 rounded-full blur-3xl animate-breathe-slow"></div>
        <div class="absolute bottom-10 left-1/4 w-72 h-72 bg-gradient-to-br from-terracotta/10 to-honey/5 rounded-full blur-3xl animate-breathe-slow" style="animation-delay: 1.5s;"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-charcoal mb-8 leading-tight">
          Find Your Place in SUUNA
        </h1>
        <p class="text-xl md:text-2xl text-ash max-w-2xl mx-auto leading-relaxed font-light">
          Whether you're seeking belonging or sharing your gifts.
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-moss to-sage mx-auto rounded-full mt-8"></div>
      </div>
    </section>

    <!-- Two Paths Section -->
    <section class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

          <!-- For Learners -->
          <article class="group bg-white/90 backdrop-blur-sm rounded-2xl p-12 shadow-xl shadow-sage/10 hover:shadow-2xl hover:shadow-sage/15 transition-all duration-500 hover:-translate-y-1 border border-sage/10">
            <div class="text-6xl mb-8 text-center animate-breathe-slow">🌱</div>

            <h2 class="text-3xl md:text-4xl font-display font-semibold text-charcoal mb-6 text-center">
              Join the Community
            </h2>

            <p class="text-lg text-ash mb-10 text-center leading-relaxed">
              A free, intentional space to connect, learn, and contribute.
            </p>

            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-sage flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-charcoal">
                  Connect with like-minded seekers and wisdom keepers
                </p>
              </div>

              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-sage flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-charcoal">
                  Access workshops, events, and transformational content
                </p>
              </div>

              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-sage flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-charcoal">
                  Participate in discussions and share your journey
                </p>
              </div>

              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-sage flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-charcoal">
                  No algorithms, no ads — just authentic connection
                </p>
              </div>
            </div>

            <div class="text-center">
              <button
                onclick="mw('show')"
                class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-br from-sage to-forest text-white font-semibold rounded-2xl hover:shadow-xl hover:shadow-sage/30 transition-all duration-300 hover:scale-105 shadow-lg shadow-sage/25"
              >
                <span class="group-hover:scale-105 transition-transform duration-300">Explore Community</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </button>
            </div>
          </article>

          <!-- For Guides -->
          <article class="group bg-white/90 backdrop-blur-sm rounded-2xl p-12 shadow-xl shadow-terracotta/10 hover:shadow-2xl hover:shadow-terracotta/15 transition-all duration-500 hover:-translate-y-1 border border-terracotta/10">
            <div class="text-6xl mb-8 text-center animate-breathe-slow" style="animation-delay: 1s;">✨</div>

            <h2 class="text-3xl md:text-4xl font-display font-semibold text-charcoal mb-6 text-center">
              Share Your Work with SUUNA
            </h2>

            <p class="text-lg text-ash mb-10 text-center leading-relaxed">
              We provide the platform, tools, and community.
            </p>

            <div class="bg-stone/30 backdrop-blur-sm rounded-2xl p-8 mb-10 border border-terracotta/10">
              <h3 class="text-xl font-display font-bold mb-4">What you get:</h3>

              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Your own space within SUUNA</p>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Event management (Luma integration)</p>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Workshop hosting (Gumroad/Vault)</p>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Newsletter support (Substack)</p>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Community platform (suuna.org)</p>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p>Optional: Full production partnership with Respira</p>
                </div>
              </div>
            </div>

            <div class="text-center">
              <a
                href="https://cal.com/mihai-love/suuna"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-br from-terracotta to-clay text-white font-semibold rounded-2xl hover:shadow-xl hover:shadow-terracotta/30 transition-all duration-300 hover:scale-105 shadow-lg shadow-terracotta/25"
              >
                <span class="group-hover:scale-105 transition-transform duration-300">Schedule a Conversation</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Manifesto CTA -->
    <section class="py-20 px-4 bg-gradient-to-br from-stone/20 to-bone">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-charcoal mb-6 leading-tight">
          Want to learn more about SUUNA?
        </h2>
        <p class="text-lg md:text-xl text-ash mb-10 leading-relaxed">
          Read our manifesto to understand our vision and values.
        </p>
        <a
          href="/manifesto"
          class="group inline-flex items-center gap-2 px-8 py-4 bg-white/90 backdrop-blur-sm border-2 border-sage/30 text-charcoal font-medium rounded-2xl hover:bg-white hover:border-sage/50 transition-all duration-300 hover:-translate-y-0.5 shadow-md hover:shadow-lg shadow-sage/10"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Read Our Manifesto</span>
          <svg class="w-5 h-5 text-sage group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>
