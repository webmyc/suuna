---
import Base from '../components/layout/Base.astro';

// Page metadata
const title = 'SUUNA Vault - Workshops & Courses';
const description = 'Workshops, courses, and masterclasses from our guides. Access exclusive content and transformational offerings.';

// For now, we'll use placeholder data for Gumroad products
// In production, this would fetch from Gumroad API or be managed in a JSON file
const products = [
  {
    id: 'magma-mater',
    title: 'Magma Mater: Sacred Feminine Journey',
    creator: 'Laura-Maria Yara',
    price: '€297',
    description: '8-week journey into sacred feminine power through womb work and embodied practices.',
    image: '/images/vault/magma-mater.jpg',
    link: 'https://bliss.suuna.ro/magma-mater',
    featured: true
  },
  {
    id: 'blueprint-course',
    title: 'Erotic Blueprint Mastery',
    creator: 'Melissa Louise',
    price: '€197',
    description: 'Complete course to discover and master your unique erotic blueprint.',
    image: '/images/vault/erotic-blueprint.jpg',
    link: 'https://bliss.suuna.ro/erotic-blueprint',
    featured: true
  },
  {
    id: 'ci-training',
    title: 'Compassionate Inquiry Training',
    creator: 'Stephanie Canavesio',
    price: '€247',
    description: 'Deep dive into Dr. Gabor Maté\'s approach to trauma healing and self-discovery.',
    image: '/images/vault/compassionate-inquiry.jpg',
    link: 'https://bliss.suuna.ro/compassionate-inquiry',
    featured: true
  },
  {
    id: 'espere-workshop',
    title: 'Ecologia Emoțiilor - Workshop Series',
    creator: 'Dana Dragomirescu',
    price: '€147',
    description: 'Workshop series pentru reconectarea cu corpul și emoțiile prin metoda ESPERE®.',
    image: '/images/vault/ecologia-emotiilor.jpg',
    link: 'https://bliss.suuna.ro/ecologia-emotiilor',
    featured: false
  }
];
---

<Base title={title} description={description} canonical="https://suuna.ro/vault">
  <div class="min-h-screen bg-bone">
    <!-- Hero Section -->
    <section class="relative pt-36 pb-20 px-4 bg-gradient-to-br from-bone via-white to-sage/10 overflow-hidden">
      <!-- Subtle organic background -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/3 w-80 h-80 bg-gradient-to-br from-sage/15 to-forest/5 rounded-full blur-3xl animate-breathe-slow"></div>
        <div class="absolute bottom-10 right-1/3 w-72 h-72 bg-gradient-to-br from-honey/15 to-terracotta/5 rounded-full blur-3xl animate-breathe-slow" style="animation-delay: 1s;"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-charcoal mb-8 leading-tight">
          SUUNA Vault
        </h1>
        <p class="text-xl md:text-2xl text-ash max-w-2xl mx-auto leading-relaxed font-light">
          Workshops, courses, and masterclasses from our guides.
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-sage to-forest mx-auto rounded-full mt-8"></div>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="py-16 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {products.map((product) => (
            <article class="group bg-white/90 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl shadow-sage/10 hover:shadow-2xl hover:shadow-sage/15 transition-all duration-500 hover:-translate-y-2 border border-sage/10">
              <!-- Product Image -->
              <div class="aspect-video bg-gradient-to-br from-sage to-forest relative overflow-hidden">
                {product.featured && (
                  <div class="absolute top-4 right-4 bg-terracotta text-white px-4 py-2 rounded-xl text-sm font-medium shadow-lg">
                    Featured
                  </div>
                )}
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-white text-center p-6">
                    <div class="text-5xl mb-3 animate-breathe-slow">📚</div>
                    <p class="text-sm opacity-90">Course Image Placeholder</p>
                  </div>
                </div>
              </div>

              <!-- Product Info -->
              <div class="p-8">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-xl font-display font-bold text-charcoal leading-tight flex-1">
                    {product.title}
                  </h3>
                  <span class="text-2xl font-bold text-sage ml-4">
                    {product.price}
                  </span>
                </div>

                <p class="text-sm text-terracotta font-medium mb-3">
                  by {product.creator}
                </p>

                <p class="text-ash mb-6 line-clamp-3">
                  {product.description}
                </p>

                <a
                  href={product.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block w-full text-center px-6 py-3.5 bg-gradient-to-br from-sage to-forest text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-sage/30 transition-all duration-300 hover:scale-105"
                >
                  <span class="group-hover:scale-105 transition-transform duration-300 inline-block">View on Gumroad</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-24 px-4 bg-gradient-to-br from-sage via-forest to-sage overflow-hidden">
      <!-- Organic background elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-white/5 rounded-full blur-3xl animate-float" style="animation-duration: 10s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-moss/20 rounded-full blur-3xl animate-float" style="animation-duration: 12s; animation-delay: 2s;"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-display font-semibold text-white mb-6 leading-tight">
          Are You a Guide?
        </h2>
        <p class="text-lg md:text-xl text-white/90 mb-12 max-w-2xl mx-auto leading-relaxed font-light">
          Share your workshops and courses with the SUUNA community.
        </p>
        <a
          href="/join"
          class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-sage font-semibold rounded-2xl transition-all duration-300 hover:bg-bone hover:scale-105 shadow-xl shadow-forest/30"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Partner with SUUNA</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
