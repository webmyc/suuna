---
import Base from '../components/layout/Base.astro';

// Page metadata
const title = 'SUUNA Vault - Workshops & Courses';
const description = 'Workshops, courses, and masterclasses from our guides. Access exclusive content and transformational offerings.';

// For now, we'll use placeholder data for Gumroad products
// In production, this would fetch from Gumroad API or be managed in a JSON file
const products = [
  {
    id: 'magma-mater',
    title: 'Magma Mater: Sacred Feminine Journey',
    creator: 'Laura-Maria Yara',
    price: '€297',
    description: '8-week journey into sacred feminine power through womb work and embodied practices.',
    image: '/images/vault/magma-mater.jpg',
    link: 'https://bliss.suuna.ro/magma-mater',
    featured: true
  },
  {
    id: 'blueprint-course',
    title: 'Erotic Blueprint Mastery',
    creator: 'Melissa Louise',
    price: '€197',
    description: 'Complete course to discover and master your unique erotic blueprint.',
    image: '/images/vault/erotic-blueprint.jpg',
    link: 'https://bliss.suuna.ro/erotic-blueprint',
    featured: true
  },
  {
    id: 'ci-training',
    title: 'Compassionate Inquiry Training',
    creator: 'Stephanie Canavesio',
    price: '€247',
    description: 'Deep dive into Dr. Gabor Maté\'s approach to trauma healing and self-discovery.',
    image: '/images/vault/compassionate-inquiry.jpg',
    link: 'https://bliss.suuna.ro/compassionate-inquiry',
    featured: true
  },
  {
    id: 'espere-workshop',
    title: 'Ecologia Emoțiilor - Workshop Series',
    creator: 'Dana Dragomirescu',
    price: '€147',
    description: 'Workshop series pentru reconectarea cu corpul și emoțiile prin metoda ESPERE®.',
    image: '/images/vault/ecologia-emotiilor.jpg',
    link: 'https://bliss.suuna.ro/ecologia-emotiilor',
    featured: false
  }
];
---

<Base title={title} description={description} canonical="https://suuna.ro/vault">
  <div class="min-h-screen bg-bone">
    <!-- Hero Section - Bold and Inviting -->
    <section class="relative pt-40 pb-28 px-4 bg-gradient-to-br from-bone via-white to-sage/10 overflow-hidden">
      <!-- Bold organic background with real depth -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/3 w-[550px] h-[550px] bg-gradient-to-br from-sage/18 to-forest/8 rounded-full blur-[120px] animate-float-slow"></div>
        <div class="absolute bottom-10 right-1/3 w-[500px] h-[500px] bg-gradient-to-br from-honey/18 to-terracotta/8 rounded-full blur-[120px] animate-float-slower"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-gradient-radial from-sage/8 to-transparent rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-display font-semibold text-charcoal mb-10 leading-none tracking-tight"
            style="text-shadow: 0 4px 30px rgba(74, 124, 89, 0.15);">
          SUUNA Vault
        </h1>
        <p class="text-2xl sm:text-3xl md:text-4xl text-ash max-w-3xl mx-auto leading-relaxed font-light mb-10">
          Workshops, courses, and masterclasses from our guides.
        </p>
        <div class="w-32 h-2 bg-gradient-to-r from-sage via-forest to-sage mx-auto rounded-full shadow-lg shadow-sage/30"></div>
      </div>
    </section>

    <!-- Products Grid - Bold Cards with Real Presence -->
    <section class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
          {products.map((product) => (
            <article class="group bg-white/95 backdrop-blur-md rounded-[32px] overflow-hidden shadow-2xl shadow-sage/20 hover:shadow-2xl hover:shadow-sage/30 transition-all duration-500 hover:-translate-y-2 hover:scale-[1.02] border-2 border-sage/15">
              <!-- Product Image -->
              <div class="aspect-video bg-gradient-to-br from-sage to-forest relative overflow-hidden">
                {product.featured && (
                  <div class="absolute top-5 right-5 bg-terracotta text-white px-5 py-2.5 rounded-[16px] text-base font-semibold shadow-xl shadow-terracotta/40">
                    Featured
                  </div>
                )}
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-white text-center p-6">
                    <div class="text-7xl mb-4 animate-breathe-slow">📚</div>
                    <p class="text-base opacity-90 font-medium">Course Image Placeholder</p>
                  </div>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>

              <!-- Product Info -->
              <div class="p-10">
                <div class="flex items-start justify-between mb-4">
                  <h3 class="text-2xl font-display font-bold text-charcoal leading-tight flex-1">
                    {product.title}
                  </h3>
                  <span class="text-3xl font-bold text-sage ml-4">
                    {product.price}
                  </span>
                </div>

                <p class="text-base text-terracotta font-semibold mb-4">
                  by {product.creator}
                </p>

                <p class="text-base text-ash/80 mb-8 line-clamp-3 leading-relaxed">
                  {product.description}
                </p>

                <a
                  href={product.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/button block w-full text-center px-8 py-4 bg-gradient-to-br from-sage to-forest text-white font-semibold text-base rounded-[20px] hover:shadow-xl hover:shadow-sage/40 transition-all duration-300 hover:scale-105"
                >
                  <span class="group-hover/button:scale-105 transition-transform duration-300 inline-block">View on Gumroad</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section - Bold and Inviting -->
    <section class="relative py-32 px-4 bg-gradient-to-br from-sage via-forest to-sage overflow-hidden">
      <!-- Large organic background elements with real depth -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-white/8 rounded-full blur-[120px] animate-float" style="animation-duration: 10s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-moss/25 rounded-full blur-[120px] animate-float" style="animation-duration: 12s; animation-delay: 2s;"></div>
        <div class="absolute top-1/2 right-1/3 w-[400px] h-[400px] bg-white/5 rounded-full blur-3xl animate-breathe-slow"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-white mb-8 leading-tight tracking-tight"
            style="text-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);">
          Are You a Guide?
        </h2>
        <p class="text-xl sm:text-2xl lg:text-3xl text-white/95 max-w-3xl mx-auto mb-16 leading-relaxed font-light">
          Share your workshops and courses with the SUUNA community.
        </p>
        <a
          href="/join"
          class="group inline-flex items-center gap-3 px-12 py-6 bg-white text-sage font-bold text-lg rounded-[28px] transition-all duration-300 hover:bg-bone hover:scale-105 shadow-2xl shadow-forest/40 hover:shadow-2xl hover:shadow-forest/50"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Partner with SUUNA</span>
          <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
