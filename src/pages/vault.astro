---
import Base from '../components/layout/Base.astro';
import { Image } from 'astro:assets';
import { getProducts } from '../lib/gumroad';
import type { GumroadProduct } from '../lib/gumroad';

// Page metadata
const title = 'SUUNA Vault - Curated Digital Assets';
const description = 'A curated collection of workshops, courses, and masterclasses from our guides.';

// Fetch products from Gumroad
const products: GumroadProduct[] = await getProducts();

// Helper to determine span classes based on index or feature status
const getGridClasses = (index: number, product: GumroadProduct) => {
  // Example logic: First item spans 2 cols if featured, or every 7th item spans 2 cols
  if (index === 0 || index % 7 === 0) {
    return 'md:col-span-2 md:row-span-2';
  }
  if (index % 5 === 0) {
      return 'md:col-span-2';
  }
  return 'col-span-1 row-span-1';
};
---

<Base title={title} description={description} canonical="https://suuna.ro/vault">
  <div class="min-h-screen bg-bone dark:bg-[#0D1B22] pb-24">
    <!-- Header Section -->
    <section class="relative pt-32 pb-16 px-6 md:px-12 max-w-7xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-display font-bold text-charcoal dark:text-bone tracking-tight mb-6">
            The Vault
        </h1>
        <p class="text-xl text-ash dark:text-[#B8C5D0] max-w-2xl mx-auto font-light leading-relaxed">
            A curated repository of wisdom, tools, and digital artifacts for your journey.
        </p>
    </section>

    <!-- Products Grid - Bold Cards with Real Presence -->
    <section class="py-16 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
          {products.map((product) => (
            <article class="group bg-white/95 backdrop-blur-md rounded-[8px] overflow-hidden shadow-2xl shadow-sage/20 hover:shadow-2xl hover:shadow-sage/30 transition-all duration-500 hover:-translate-y-2 hover:scale-[1.02] border-2 border-sage/15">
              <!-- Product Image -->
              <div class="aspect-video bg-gradient-to-br from-sage to-forest relative overflow-hidden">
                {product.featured && (
                  <div class="absolute top-5 right-5 bg-terracotta text-white px-5 py-2.5 rounded-[8px] text-base font-semibold shadow-xl shadow-terracotta/40">
                    Featured
                  </div>
                )}
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-white text-center p-6">
                    <div class="text-7xl mb-4 animate-breathe-slow">📚</div>
                    <p class="text-base opacity-90 font-medium">Course Image Placeholder</p>
                  </div>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>

              <!-- Product Info -->
              <div class="p-10">
                <div class="flex items-start justify-between mb-4">
                  <h3 class="text-2xl font-display font-bold text-charcoal leading-tight flex-1">
                    {product.title}
                  </h3>
                  <span class="text-3xl font-bold text-sage ml-4">
                    {product.price}
                  </span>
                </div>

                <p class="text-base text-terracotta font-semibold mb-4">
                  by {product.creator}
                </p>

                <p class="text-base text-ash mb-8 line-clamp-3 leading-relaxed">
                  {product.description}
                </p>

                <a
                  href={product.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/button block w-full text-center px-8 py-4 bg-gradient-to-br from-sage to-forest text-white font-semibold text-base rounded-[8px] hover:shadow-xl hover:shadow-sage/40 transition-all duration-300 hover:scale-105"
                >
                  <span class="group-hover/button:scale-105 transition-transform duration-300 inline-block">View on Gumroad</span>
                </a>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section - Bold and Inviting -->
    <section class="relative py-28 px-4 bg-gradient-to-br from-sage via-forest to-sage overflow-hidden">
      <!-- Large organic background elements with real depth -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-white/8 rounded-full blur-[120px] animate-float" style="animation-duration: 10s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-moss/25 rounded-full blur-[120px] animate-float" style="animation-duration: 12s; animation-delay: 2s;"></div>
        <div class="absolute top-1/2 right-1/3 w-[400px] h-[400px] bg-white/5 rounded-full blur-3xl animate-breathe-slow"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-white mb-8 leading-tight tracking-tight"
            style="text-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);">
          Are You a Guide?
        </h2>
        <p class="text-xl sm:text-2xl lg:text-3xl text-white/95 max-w-3xl mx-auto mb-16 leading-relaxed font-light">
          Share your workshops and courses with the SUUNA community.
        </p>
        <a
          href="/join"
          class="group inline-flex items-center gap-3 px-8 py-4 bg-white text-sage font-bold text-lg rounded-[8px] transition-all duration-300 hover:bg-bone hover:scale-105 shadow-2xl shadow-forest/40 hover:shadow-2xl hover:shadow-forest/50"
        >
          <span class="group-hover:scale-105 transition-transform duration-300">Partner with SUUNA</span>
          <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>
