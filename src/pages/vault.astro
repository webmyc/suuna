---
import Base from '../components/layout/Base.astro';
import { Image } from 'astro:assets';
import { getProducts } from '../lib/gumroad';
import type { GumroadProduct } from '../lib/gumroad';

// Page metadata
const title = 'SUUNA Vault - Curated Digital Assets';
const description = 'A curated collection of workshops, courses, and masterclasses from our guides.';

// Fetch products from Gumroad
const products: GumroadProduct[] = await getProducts();

// Helper to determine span classes based on index or feature status
const getGridClasses = (index: number, product: GumroadProduct) => {
  // Example logic: First item spans 2 cols if featured, or every 7th item spans 2 cols
  if (index === 0 || index % 7 === 0) {
    return 'md:col-span-2 md:row-span-2';
  }
  if (index % 5 === 0) {
      return 'md:col-span-2';
  }
  return 'col-span-1 row-span-1';
};
---

<Base title={title} description={description} canonical="https://suuna.ro/vault">
  <div class="min-h-screen bg-monk-bg pb-24">
    <!-- Header Section -->
    <section class="relative pt-32 pb-16 px-6 md:px-12 max-w-7xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-display font-bold text-monk-text-primary tracking-tight mb-6">
            The Vault
        </h1>
        <p class="text-xl text-monk-text-secondary max-w-2xl mx-auto font-light leading-relaxed">
            A curated repository of wisdom, tools, and digital artifacts for your journey.
        </p>
    </section>

    <!-- Bento Grid -->
    <section class="px-6 md:px-12 max-w-7xl mx-auto">
      {products.length === 0 ? (
        <div class="text-center py-20 bg-white rounded-2xl border border-monk-border shadow-sm">
            <p class="text-monk-text-secondary text-lg">Connecting to the Vault...</p>
            <p class="text-sm text-gray-400 mt-2">(Ensure GUMROAD_ACCESS_TOKEN is set)</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[300px]">
          {products.map((product, index) => (
            <a 
                href={product.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class={`group relative bg-monk-surface rounded-2xl overflow-hidden border border-monk-border shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 ${getGridClasses(index, product)}`}
            >
              <!-- Image Background -->
              <div class="absolute inset-0 w-full h-full bg-gray-100">
                  {product.thumbnail_url ? (
                      <Image 
                        src={product.thumbnail_url} 
                        alt={product.name}
                        width={600}
                        height={400}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        inferSize={true}
                      />
                  ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-300">
                          <span class="text-4xl">❖</span>
                      </div>
                  )}
              </div>

              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

              <!-- Content -->
              <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
                <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
                    <div class="flex justify-between items-end mb-2">
                        <h3 class="text-lg font-bold leading-tight pr-4 font-display">
                            {product.name}
                        </h3>
                        <span class="shrink-0 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium border border-white/10">
                            {product.formatted_price}
                        </span>
                    </div>
                    
                    <div class="h-0 group-hover:h-auto overflow-hidden transition-all duration-500 opacity-0 group-hover:opacity-100">
                        <p class="text-sm text-gray-200 line-clamp-2 font-light">
                            {product.description}
                        </p>
                        <div class="mt-4 flex items-center gap-2 text-xs font-bold tracking-wider uppercase text-monk-accent">
                            <span>View Product</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                        </div>
                    </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>
